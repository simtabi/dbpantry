# dbpantry configuration
#
# Copy to .env with `make init`, which also generates secrets and certificates.
# Every value here is a default; nothing is hardcoded elsewhere.
#
# Passwords are NEVER set in this file. They live in secrets/*.txt and are
# referenced through the _FILE convention. `make check-env` refuses to start
# the stack if it finds a CHANGE_ME sentinel or a plaintext password here.
#
# Quoting: a value containing whitespace or a special character (# $ ` " ' \
# ; & | < > ( ) * ? [ ] { } ! ~) goes in double quotes, for example
#     TENANTS="landlord panel api socket queue"
# Compose, make and every script read it the same way (scripts/env-lib.sh), and
# check 50 enforces it. Plain values such as pg,ui or 127.0.0.1 stay bare.

# =============================================================================
# Core
# =============================================================================

# Pinned so container, network, and volume names are stable across machines.
COMPOSE_PROJECT_NAME=mdb

# Persistent profile selection. Engine selectors: pg, mysql, mariadb.
# Mode overlays: ui, backup, metrics, prod, test, ha.
# Override for a single run with `make up PROFILES=pg,mysql,ui`.
MDB_PROFILES="pg,ui"

# Timezone baked into every engine.
MDB_TZ=UTC

# Host bind address for every published port. 127.0.0.1 keeps databases off
# the network even when a port is published. Change deliberately.
MDB_BIND_ADDR=127.0.0.1

# -----------------------------------------------------------------------------
# Exposure: how engines are reachable from the host
# -----------------------------------------------------------------------------
# Publishing a host port is the only thing in this stack that can collide with
# software you already run, and every collision surfaces as a Docker error at
# the very end of a boot. So it is a decision rather than a default.
#
#   none    Publish NOTHING. Applications join the mdb network and reach
#           engines by service name -- pg:5432, mysql:3306 -- which is exactly
#           what `make new-project` prints. Nothing can conflict because
#           nothing is bound. This is the default.
#
#   direct  Every engine publishes its own host port. Use this for GUI clients
#           that cannot join a Docker network.
#
#   proxy   One front door (Caddy) publishes a contiguous range and forwards to
#           the engines, which stay internal. One process owns the host ports.
#
# `make psql`, `make mysql` and the other shells work in every mode: they go
# through the container, not through a published port.
MDB_PUBLISH=none

# Under the prod overlay, engines publish NO port of their own, whatever
# MDB_PUBLISH says: applications reach PostgreSQL through its pooler, which
# direct mode still publishes. true puts the engines' direct-mode ports back.
# Deprecated for prod (check-env warns); for the client that cannot use a pooler.
MDB_PUBLISH_ENGINES=false

# In direct and proxy mode every host port is BASE + the engine's offset
# (MDB_ENGINE_PORT_OFFSET in its descriptor), and a pooler's is BASE + offset
# + 100, so PostgreSQL is 54000, MySQL 54001 and the PostgreSQL pooler 54100
# with the default base. `make endpoints` prints them. One number moves all of
# them, instead of hunting through a variable per engine.
#
# 54000 is deliberately outside the ranges used by the databases themselves,
# so a published port cannot be mistaken for a native install.
MDB_PORT_BASE=54000

# Memory (GB) and CPU budget. Drive the PGTune-style presets for every engine.
# See the capacity truth table in docs/reference/spec.md section 21.1.
MDB_MEM=4
MDB_CPUS=2

# stop_grace_period per engine. Docker's default of 10s force-kills a database
# mid-checkpoint; 60s lets it shut down cleanly.
MDB_STOP_GRACE=60s

# Share a unix socket volume across containers. Container-to-container sockets
# work everywhere; host-to-container sockets work only on native Linux.
MDB_SOCKETS=false

# Internal network subnet.
MDB_NETWORK_SUBNET=172.28.0.0/16
# Its gateway, read only by MDB_BACKEND=incus (compose.incus.yml), which needs
# one named. Unset: the subnet's first host.
#MDB_NETWORK_GATEWAY=172.28.0.1

# json-file log rotation caps.
MDB_LOG_MAX_SIZE=10m
MDB_LOG_MAX_FILE=3

# -----------------------------------------------------------------------------
# Engine versions: maintained, or unsupported by choice
# -----------------------------------------------------------------------------
# Each engine's menu below lists its MAINTAINED versions: the newest supported
# line and the one before it, each built, scanned and verified in CI from a
# digest-pinned base (docs/guides/versions.md, design.md D-57).
#
# Any other version still runs if you name the upstream image it comes from in
# MDB_<ENGINE>_BASE_IMAGE, pinned by digest (name:tag@sha256:<digest>). That
# is UNSUPPORTED: dbpantry does not build, scan or verify it, gives no scan
# guarantee, and check-env says so on every start. Without the override an
# off-menu version is an error, so a typo cannot select one.

# Locale and encoding for PostgreSQL.
# WARNING: these apply at first initdb ONLY. Changing them later has no effect
# on an existing volume; migrating locale means a full dump and restore.
MDB_LOCALE=en_US.UTF-8
MDB_ENCODING=UTF8

# =============================================================================
# PostgreSQL
# =============================================================================

# Selects the image tag AND the data volume name (pg17_data). Switching majors
# starts a fresh volume; the old one stays intact for rollback or migration.
# Menu: 17 (default), 18. 15 and 16 run only through MDB_PG_BASE_IMAGE.
MDB_PG_VERSION=17

# Unsupported: the upstream image for a version off the menu, digest-pinned.
#MDB_PG_BASE_IMAGE=docker.io/pgvector/pgvector:0.8.6-pg16@sha256:...

# Overrides the BASE+offset port for this engine when MDB_PUBLISH is not
# `none`. Rarely needed -- move MDB_PORT_BASE instead and everything follows.
#MDB_PG_HOST_PORT=5432

# The database created at first init, and the database pg_cron uses.
MDB_PG_DEFAULT_DB=postgres

# Where the data volume mounts inside the container.
#
# IMPORTANT: PostgreSQL 18 changed this. Releases up to 17 expect the mount at
# /var/lib/postgresql/data. PG 18+ stores data in major-versioned subdirectories
# and expects the mount one level up, at /var/lib/postgresql, so that
# pg_upgrade --link can work. Set this to /var/lib/postgresql when
# MDB_PG_VERSION is 18 or higher; check-env refuses a mismatched pair.
MDB_PG_DATA_MOUNT=/var/lib/postgresql/data

# Multi-database provisioning: db:user:__FILE__ triplets, comma-separated.
# The __FILE__ marker resolves to secrets/pg_<user>_password.txt.
#MDB_PG_DATABASES="app:app_user:__FILE__,analytics:analytics_user:__FILE__"

# Extensions created in every provisioned database at first init.
MDB_PG_INIT_EXTENSIONS="vector,pg_stat_statements"

# Assembled into shared_preload_libraries. pg_cron and pgaudit must be here to
# work at all.
MDB_PG_SHARED_PRELOAD=pg_stat_statements

# shm_size for the pg service. Parallel HNSW index builds need shared memory of
# at least maintenance_work_mem; the Docker default of 64m is far too small.
MDB_PG_SHM=256m

# plpython3u is an UNTRUSTED language: any function runs as the database OS
# user. Off by default, superuser-only when enabled.
MDB_PG_PLPYTHON=false

# log_min_duration_statement in milliseconds. 0 disables. Dev on, prod off.
MDB_PG_SLOW_MS=500

# Embedded helpers for standalone `docker run` use. OFF under compose, which
# runs these as separate services instead.
MDB_PG_EMBED_EXPORTER=false
MDB_PG_EMBED_BACKUP=false

# =============================================================================
# MySQL
# =============================================================================

# Menu: 8.4 (LTS, default), 9.7 (LTS). Innovation releases and 8.0 run only
# through MDB_MYSQL_BASE_IMAGE.
MDB_MYSQL_VERSION=8.4

# Unsupported: the upstream image for a version off the menu, digest-pinned.
#MDB_MYSQL_BASE_IMAGE=docker.io/library/mysql:8.0.46@sha256:...
#MDB_MYSQL_HOST_PORT=3306
#MDB_MYSQL_DATABASES=app:app_user:__FILE__

# MySQL 8.4 removed mysql_native_password. Enable only for legacy clients that
# cannot speak caching_sha2_password.
MDB_MYSQL_NATIVE_PASSWORD_COMPAT=false

# Slow query log threshold in seconds. 0 disables.
MDB_MYSQL_SLOW_SECONDS=1
MDB_MYSQL_NOFILE=10240
# PITR via the binary log. Off by default for the same reason PostgreSQL's is:
# on a development machine it accumulates logs nobody will replay. NOT a live
# toggle -- log_bin needs a restart.
#
# The log is written to its own volume, never inside the data directory, so it
# survives losing the thing it recovers.
MDB_MYSQL_PITR=false
MDB_MYSQL_SERVER_ID=1
MDB_MYSQL_BINLOG_RETENTION_SECONDS=604800

MDB_MYSQL_EMBED_EXPORTER=false
MDB_MYSQL_EMBED_BACKUP=false

# =============================================================================
# MariaDB
# =============================================================================

# Menu: 11.8 (LTS, default), 12.3 (LTS). 10.11 and 11.4 run only through
# MDB_MARIADB_BASE_IMAGE. The default was 11.4 before 0.2.0; see
# docs/runbooks/upgrade.md for moving an 11.4 volume.
MDB_MARIADB_VERSION=11.8

# Unsupported: the upstream image for a version off the menu, digest-pinned.
#MDB_MARIADB_BASE_IMAGE=docker.io/library/mariadb:11.4.13@sha256:...
#MDB_MARIADB_HOST_PORT=3307
#MDB_MARIADB_DATABASES=app:app_user:__FILE__

MDB_MARIADB_SLOW_SECONDS=1
MDB_MARIADB_NOFILE=10240
# PITR via the binary log. MariaDB does not enable it by default at all.
MDB_MARIADB_PITR=false
MDB_MARIADB_SERVER_ID=1
MDB_MARIADB_BINLOG_RETENTION_SECONDS=604800

MDB_MARIADB_EMBED_EXPORTER=false
MDB_MARIADB_EMBED_BACKUP=false

# =============================================================================
# MongoDB
# =============================================================================

# Menu: 7.0 (default), 8.0, 9.0. Minor releases such as 8.3 run only through
# MDB_MONGODB_BASE_IMAGE.
#
# 8.0 and 9.0 refuse to start on Linux kernels 6.19 to 7.0.13 as `uname -r`
# reports them (SERVER-121912), which includes every Ubuntu 7.0 kernel: they
# all report 7.0.0 (SERVER-136848). 7.0 is unaffected, so it is the default.
# On a kernel reporting 7.0.14 or later, such as OrbStack's, choose 8.0 or 9.0.
MDB_MONGODB_VERSION=7.0

# Unsupported: the upstream image for a version off the menu, digest-pinned.
#MDB_MONGODB_BASE_IMAGE=docker.io/library/mongo:8.3.11@sha256:...
#MDB_MONGODB_HOST_PORT=27017
#MDB_MONGODB_DATABASES=app:app_user:__FILE__

# MongoDB is SSPL-licensed, so we reference the upstream image rather than
# publishing a derived one. See docs/guides/licensing.md. Override to pin your own
# mirror; it must stay digest-pinned. It takes precedence over
# MDB_MONGODB_BASE_IMAGE.
#MDB_MONGODB_IMAGE=docker.io/library/mongo:7.0.45@sha256:...

# The root user created on first run. The upstream image starts with NO
# authentication at all unless these are supplied; the toolkit always supplies
# them.
MDB_MONGODB_ROOT_USER=root

MDB_MONGODB_EMBED_EXPORTER=false
MDB_MONGODB_EMBED_BACKUP=false

# =============================================================================
# Apache Cassandra
# =============================================================================

# Menu: 5.0 (default). 4.1 was dropped in 0.2.0 (design.md D-57) and runs only
# through MDB_CASSANDRA_BASE_IMAGE; docs/runbooks/upgrade.md moves a 4.1 volume to 5.0.
MDB_CASSANDRA_VERSION=5.0

# Unsupported: the upstream image for a version off the menu, digest-pinned.
#MDB_CASSANDRA_BASE_IMAGE=docker.io/library/cassandra:4.1.12@sha256:...
#MDB_CASSANDRA_HOST_PORT=9042
#MDB_CASSANDRA_DATABASES=app:app_user:__FILE__

# Cassandra calls a database a keyspace; MDB_CASSANDRA_DATABASES creates
# keyspaces with SimpleStrategy and RF=1, which is the correct choice for a
# single-node development cluster and the wrong one for a real one.
MDB_CASSANDRA_CLUSTER=mdb

# JVM heap. Cassandra is the heaviest engine here: it will not start in under
# ~1G, and the default suits a laptop rather than a server. HEAP_NEW is the
# young generation and is conventionally ~100M per core.
MDB_CASSANDRA_HEAP=1G
MDB_CASSANDRA_HEAP_NEW=200M

MDB_CASSANDRA_EMBED_EXPORTER=false
MDB_CASSANDRA_EMBED_BACKUP=false

# =============================================================================
# FerretDB
# =============================================================================

# An Apache-2.0 document database that speaks the MongoDB wire protocol and
# stores data in PostgreSQL. Use it instead of MongoDB when SSPL is
# unacceptable; read the limitations in docs/guides/licensing.md first, because it is
# a drop-in for most workloads and not all.
MDB_FERRETDB_VERSION=2

# Unsupported: the upstream image for a version off the menu, digest-pinned.
#MDB_FERRETDB_BASE_IMAGE=ghcr.io/ferretdb/ferretdb:2.1.0@sha256:...
#MDB_FERRETDB_HOST_PORT=27018
#MDB_FERRETDB_DATABASES=app:app_user:__FILE__

MDB_FERRETDB_EMBED_EXPORTER=false
MDB_FERRETDB_EMBED_BACKUP=false

# =============================================================================
# Connection pooling
# =============================================================================

# `make up PROFILES=pg,pooler` puts pgBouncer on 6432 in front of PostgreSQL.
# Point your application at 6432 rather than 5432.
#
# Required in production, optional in development. PostgreSQL forks one OS
# process per connection at roughly 10 MB each, so 500 direct connections cost
# ~5 GB before serving a single query. The MySQL family uses a thread per
# connection and does not have this problem; MongoDB, Cassandra and FerretDB
# pool in the driver and must NOT be put behind a proxy. See docs/guides/pooling.md.
#MDB_PG_POOLER_HOST_PORT=6432
# The HA pooler (`pgbouncer`, in front of HAProxy's write port) publishes here on
# MDB_BIND_ADDR, like HAProxy's own ports. Started by PROFILES=ha,pooler.
#MDB_HA_POOLER_HOST_PORT=6432
# Prod limits for the HA pooler (compose.prod.yml).
#MDB_PGBOUNCER_CPU_LIMIT=1
#MDB_PGBOUNCER_MEM_LIMIT=256m

# transaction | session | statement.
#
# transaction returns a server connection to the pool at every COMMIT, which is
# what makes the multiplexing ratio large -- and what breaks anything holding
# SESSION state: LISTEN/NOTIFY, advisory locks across transactions, session-level
# SET (use SET LOCAL), WITHOUT HOLD cursors. Use session mode if you need those,
# and expect a much lower ratio.
MDB_PGBOUNCER_POOL_MODE=transaction

# Server connections per database/user pair. This is the number PostgreSQL
# actually sees; 25 is a sane default for a machine with a handful of cores.
MDB_PGBOUNCER_DEFAULT_POOL_SIZE=25
MDB_PGBOUNCER_MIN_POOL_SIZE=5
MDB_PGBOUNCER_RESERVE_POOL_SIZE=5

# Client connections the pooler will accept. This is the number your
# application sees, and it is meant to be far larger than the pool size.
MDB_PGBOUNCER_MAX_CLIENT_CONN=1000
MDB_PGBOUNCER_MAX_DB_CONNECTIONS=50

# Transaction pooling could not support prepared statements at all until
# pgBouncer 1.21 learned to track them per client. 0 disables them again.
MDB_PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# ProxySQL, for the MySQL family. Optional -- thread-per-connection is far
# cheaper than PostgreSQL's process-per-connection, so this is a scaling aid
# rather than a rescue. See docs/guides/pooling.md.
#
# It mirrors each user's password VERIFIER from mysql.user, never a cleartext
# password, so it holds no more than the server already does.
#MDB_MYSQL_POOLER_HOST_PORT=6033
#MDB_MARIADB_POOLER_HOST_PORT=6034
MDB_PROXYSQL_MAX_BACKEND_CONN=100

# =============================================================================
# TLS and secrets
# =============================================================================

# Enforce TLS at the server: hostssl-only pg_hba, require_secure_transport for
# the MySQL family. Unix sockets still count as a secure transport, so socket
# connections keep working. Forced true in the prod profile.
MDB_TLS_ENFORCE=false

# Extra SANs on generated server certificates, comma-separated. An IP address
# also gets an IP: SAN, so verify-full by address works. Re-issue with
# `make certs-renew` after changing this.
#MDB_EXTRA_SANS="db.internal,10.0.0.5"

# Mutual TLS: client certificates required (clientcert=verify-full on PG,
# REQUIRE X509 on the MySQL family).
MDB_MTLS=false

# Set by scripts/gen-compose, never by hand: each pooler's fixed address on the
# toolkit network, near the top of MDB_NETWORK_SUBNET. Under MDB_MTLS the engine
# lets that one address log in with a toolkit-CA certificate whose CN is not a
# role (the pooler logs in as every role); everyone else needs CN = role.
#MDB_PG_POOLER_ADDR=
#MDB_MYSQL_POOLER_ADDR=
#MDB_MARIADB_POOLER_ADDR=

# Server certificate lifetime in days.
MDB_CERT_DAYS=825

# Secret files. Generated by `make init`; never contain a value in this file.
MDB_PG_SUPERUSER_PASSWORD_FILE=secrets/pg_superuser_password.txt
MDB_MYSQL_ROOT_PASSWORD_FILE=secrets/mysql_root_password.txt
MDB_MARIADB_ROOT_PASSWORD_FILE=secrets/mariadb_root_password.txt
MDB_MONGODB_ROOT_PASSWORD_FILE=secrets/mongodb_root_password.txt
MDB_CASSANDRA_ROOT_PASSWORD_FILE=secrets/cassandra_root_password.txt
MDB_FERRETDB_ROOT_PASSWORD_FILE=secrets/ferretdb_root_password.txt

# HA. The replication role is NOT the superuser: a standby only needs
# REPLICATION, and giving every replica the superuser password makes each one a
# full compromise of the primary. Patroni's REST API is authenticated because
# HAProxy trusts it to decide where writes go.
MDB_PG_REPLICATION_PASSWORD_FILE=secrets/pg_replication_password.txt
MDB_PATRONI_REST_PASSWORD_FILE=secrets/patroni_rest_password.txt

# =============================================================================
# Backup
# =============================================================================

# Where dumps are written. Inside the backup sidecars this is /backups, mounted
# from the same directory, so both callers of scripts/backup agree on it.
MDB_BACKUP_DIR=backups
# Where `make upgrade` keeps the dumps it moves between majors: backups/upgrade
# in the checkout unless MDB_UPGRADE_DIR is set in the ENVIRONMENT (it is not
# read from this file). The verify harness sets it to a private directory.
#MDB_UPGRADE_DIR=backups/upgrade

MDB_BACKUP_SCHEDULE=0300
# Seconds between scheduled runs in the sidecars. 86400 is nightly.
MDB_BACKUP_INTERVAL_SECONDS=86400
MDB_BACKUP_COMPRESSION=ZSTD
# zstd level: 9 is a good size/speed balance for database dumps; 19 is much
# slower for a few percent.
MDB_BACKUP_ZSTD_LEVEL=9
# Reserved. Nothing encrypts the dumps in MDB_BACKUP_DIR or the copies pushed
# to S3 yet; `true` does nothing, and check-env warns when it is set. The PITR
# repository is encrypted separately, by pgBackRest, with
# secrets/pgbackrest_cipher_passphrase.txt (Point-in-time recovery, below).
MDB_BACKUP_ENCRYPT=false

# GFS retention tiers.
MDB_BACKUP_RETAIN_DAILY=7
MDB_BACKUP_RETAIN_WEEKLY=4
MDB_BACKUP_RETAIN_MONTHLY=6

# S3-compatible target (S3, R2, B2, Wasabi, MinIO). Wiring is present but
# inactive until MDB_S3_BUCKET is set.
# rclone's S3 provider: AWS, Minio, Wasabi, Ceph, Cloudflare, Other. Getting
# this wrong usually surfaces as a signature error rather than a config error.
#MDB_S3_PROVIDER=Other
#MDB_S3_BUCKET=
#MDB_S3_HOST=
#MDB_S3_REGION=
#MDB_S3_KEY_ID_FILE=secrets/s3_key_id.txt
#MDB_S3_KEY_SECRET_FILE=secrets/s3_key_secret.txt

# Failure webhook, so backups never fail silently.
#MDB_BACKUP_NOTIFY_URL=

# -----------------------------------------------------------------------------
# Point-in-time recovery (PostgreSQL)
# -----------------------------------------------------------------------------
# A dump gives you the moment it ran. WAL archiving lets you stop recovery at
# any instant the archive covers -- including the second before someone ran a
# DELETE with no WHERE clause.
#
# OFF by default: archiving on a development machine fills a disk with segments
# nobody will replay. The prod profile requires it.
#
# NOT a live toggle. archive_mode cannot be reloaded, so turning this on takes
# effect at the next restart.
MDB_PG_PITR=false
MDB_PGBACKREST_STANZA=mdb

# posix (a local volume) or s3. Local is fine for practising recovery and is
# NOT a backup: it dies with the machine.
MDB_PGBACKREST_REPO_TYPE=posix
MDB_PGBACKREST_REPO_PATH=/var/lib/pgbackrest
MDB_PGBACKREST_RETENTION_FULL=2

# Forces a WAL switch when the database is idle. Without it the last partial
# segment can sit unarchived indefinitely, so the recoverable point stops
# advancing while everything still looks healthy.
MDB_PG_ARCHIVE_TIMEOUT=60

# Where the MySQL family writes binary logs. A separate volume from the data
# directory on purpose.
MDB_BINLOG_DIR=/var/lib/mdb-binlog

# Off-site repository. Any S3-compatible store works -- AWS, MinIO, Backblaze
# B2, Cloudflare R2, Wasabi. The keys live in secrets/, never here, and the
# repository is encrypted before it leaves the machine.
#MDB_PGBACKREST_S3_BUCKET=my-backups
#MDB_PGBACKREST_S3_ENDPOINT=s3.us-east-1.amazonaws.com
#MDB_PGBACKREST_S3_REGION=us-east-1
#MDB_PGBACKREST_S3_PATH=/pgbackrest
# MinIO and most self-hosted stores need path style; AWS does not.
#MDB_PGBACKREST_S3_URI_STYLE=path

# =============================================================================
# UIs and the Caddy front door
# =============================================================================

MDB_CADDY_HTTP_PORT=80
MDB_CADDY_HTTPS_PORT=443

# Contact address for Let's Encrypt. Required by the PROD Caddy template and
# unused in dev, where Caddy's internal CA needs no ACME account. Rendering the
# prod config without it fails loudly rather than publishing a UI with no
# certificate.
#MDB_CADDY_ACME_EMAIL=

# Hostname suffix for UI routes. *.localhost resolves to 127.0.0.1 with no
# hosts-file edit, and Caddy issues local certificates from its internal CA.
MDB_UI_DOMAIN=db.localhost

# Basic auth on every UI route. REQUIRED under the prod profile; check-env
# refuses a prod boot without it. Generate the hash with `caddy hash-password`.
#MDB_UI_BASIC_AUTH_USER=admin
#MDB_UI_BASIC_AUTH_HASH=

# The server Adminer preselects, so the UI opens ready to log in.
MDB_ADMINER_DEFAULT_SERVER=pg

# phpMyAdmin serves BOTH MySQL-family servers from one instance: PMA_HOSTS is a
# comma-separated list, and PMA_PORTS matches it positionally. Internal ports
# are 3306 for both engines; only the host-side binding differs.
MDB_PMA_HOSTS="mysql,mariadb"
MDB_PMA_PORTS="3306,3306"
MDB_PMA_UPLOAD_LIMIT=256M

# Direct per-UI ports, available in dev when Caddy is off.
#MDB_ADMINER_HOST_PORT=8080
#MDB_PMA_HOST_PORT=8081
#MDB_PGADMIN_HOST_PORT=8082

MDB_PGADMIN_EMAIL=admin@db.localhost
MDB_PGADMIN_PASSWORD_FILE=secrets/pgadmin_password.txt

# =============================================================================
# Pooling, scale, and HA (docs/reference/spec.md section 21)
# =============================================================================

# pgBouncer. Pooling is MANDATORY under the prod profile: roughly 10 MB per
# direct PostgreSQL connection means ~500 connections cost ~5 GB before a
# single query runs. check-env fails a prod boot without a reachable pooler.
MDB_PGBOUNCER_POOL_MODE=transaction
MDB_PGBOUNCER_DEFAULT_POOL_SIZE=25
# Client connections the pooler will accept. This is the number apps see; the
# pool size above is the far smaller number of real server connections behind
# it, which is the whole point of pooling.
MDB_PGBOUNCER_MAX_CLIENT_CONN=1000
#MDB_PGBOUNCER_HOST_PORT=6432

# Per-engine resource limits, applied by the prod overlay. An unbounded
# container on a VPS takes the host down with it.
MDB_PG_CPU_LIMIT=2
MDB_PG_MEM_LIMIT=4g
MDB_MYSQL_CPU_LIMIT=2
MDB_MYSQL_MEM_LIMIT=2g
MDB_MARIADB_CPU_LIMIT=2
MDB_MARIADB_MEM_LIMIT=2g
# Apple container only: compose.apple.yml also sizes these engines' VMs from
# the values below (and the three above). The prod overlay does not limit them.
#MDB_MONGODB_MEM_LIMIT=2g
#MDB_CASSANDRA_MEM_LIMIT=3g

# In prod Caddy is the only published service and must reach the public
# internet, so it binds 0.0.0.0 rather than the MDB_BIND_ADDR loopback default
# that protects the database ports.
MDB_CADDY_BIND_ADDR=0.0.0.0

# Synchronous commit for zero-data-loss replication, at a latency cost.
MDB_PG_SYNC_MODE=off

# Patroni + etcd. etcd needs a quorum of 3 nodes MINIMUM: a two-node etcd has
# lower availability than a single node, because it cannot form a majority
# after one loss.
# There is no MDB_HA_ENABLE. The `ha` profile is the switch -- `make up
# PROFILES=ha` -- because a separate flag could disagree with the profile that
# actually starts the services.
MDB_HA_CLUSTER_NAME=mdb-pg
MDB_HA_ETCD_HOSTS="etcd1:2379,etcd2:2379,etcd3:2379"

# HAProxy routes by Patroni REST health check: /primary backs the write port,
# /replica backs the read port.
MDB_HAPROXY_WRITE_PORT=5432
MDB_HAPROXY_READ_PORT=5433

# HAProxy's own stats page, on the host. Useful for seeing which backend it
# currently believes is the primary, which is the first thing worth checking
# when the write port behaves unexpectedly.
MDB_HAPROXY_STATS_PORT=7000

# Seconds allowed for leader election before the CI failover check fails.
#
# 60, not 30. Patroni holds the leader lock for `ttl` seconds and no election
# can complete before it expires, so a budget at or below the ttl can never be
# met however well the cluster behaves. The ttl is 20 here; the rest is the
# detection loop, the new leader promoting, and HAProxy's health check noticing.
MDB_HA_FAILOVER_BUDGET=60

# How the stack is deployed (design.md D-62, docs/guides/runtimes.md):
# compose (the default: Docker, Podman, nerdctl, Apple container) or
# kubernetes (the Helm chart in deploy/helm/dbpantry, docs/guides/kubernetes.md) or
# incus (incus-compose on Incus, untested, docs/guides/incus.md).
#MDB_BACKEND=compose

# --- Incus (MDB_BACKEND=incus) ----------------------------------------------
# Storage pool holding the project's volumes, and the incus-compose command.
#MDB_INCUS_POOL=default
#MDB_INCUS_COMPOSE=incus-compose

# --- Kubernetes (MDB_BACKEND=kubernetes) ------------------------------------
# The kubeconfig context to deploy to. Required: dbpantry never deploys to
# whatever context happens to be current. See `kubectl config get-contexts`.
#MDB_K8S_CONTEXT=orbstack
# Namespace and Helm release. Both default to COMPOSE_PROJECT_NAME.
#MDB_K8S_NAMESPACE=mdb
#MDB_K8S_RELEASE=mdb
# StorageClass for the data and recovery volumes. Empty uses the cluster's
# default class.
#MDB_K8S_STORAGE_CLASS=
# Extra Helm values files, colon-separated, applied after the ones rendered
# from this file (storage sizes, node selectors, Service type, ...).
#MDB_K8S_VALUES=deploy/helm/my-values.yaml
# Copy the locally built images into the cluster: auto does it on kind-*
# contexts only (OrbStack and Docker Desktop share Docker's images; a real
# cluster pulls from your registry), true forces it, false never does.
#MDB_K8S_LOAD_IMAGES=auto
# PostgreSQL HA on Kubernetes (the ha profile, design.md D-65): patroni (the
# default; the leader lock lives in ConfigMaps, no etcd) or cnpg
# (CloudNativePG; install its operator in the cluster first).
#MDB_K8S_HA_PROVIDER=patroni
#MDB_K8S_HA_REPLICAS=3
# `make up` waits this many seconds for a CloudNativePG Cluster's instances to
# be ready (helm --wait cannot see a custom resource), then fails with the
# Cluster's phase. Empty uses MDB_WAIT_TIMEOUT, else 600.
#MDB_K8S_CNPG_READY_TIMEOUT=600
# Set by the chart on the Patroni pods, not here: MDB_PATRONI_DCS=kubernetes
# (Compose uses etcd3), MDB_PATRONI_K8S_NAMESPACE and MDB_PATRONI_K8S_LABELS
# (where Patroni keeps its ConfigMaps and how it finds its pods) and
# MDB_PATRONI_CONNECT_ADDRESS (the pod IP).
#MDB_PATRONI_DCS=etcd3
#MDB_PATRONI_K8S_NAMESPACE=
#MDB_PATRONI_K8S_LABELS=
#MDB_PATRONI_CONNECT_ADDRESS=
# The backup profile's CronJobs run daily at MDB_BACKUP_SCHEDULE, in MDB_TZ.
# A full cron line here overrides it.
#MDB_K8S_BACKUP_SCHEDULE="0 3 * * *"
# Size of each engine's backup volume (one claim per engine, created by make
# up; make down and make destroy keep it, destroy --include-recovery deletes it).
#MDB_K8S_BACKUP_STORAGE=20Gi

# Compose reads both files. Engine services are generated into
# compose.engines.yml from the descriptors, so a bare `docker compose` command
# anywhere sees them without -f flags. On Apple container (socktainer) append
# :compose.apple.yml, which sizes each engine's VM (docs/guides/runtime-apple-container.md).
# `make init-prod` appends :compose.prod.yml:compose.prod.engines.yml, the prod
# overlay; `make prod-overlay ENV_FILE=...` does the same for an older file.
COMPOSE_FILE=docker-compose.yml:compose.engines.yml:compose.proxy.yml:compose.ha.yml
