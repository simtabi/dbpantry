# dbpantry web front door — DEV.
#
# Rendered by scripts/env-render; edit this template, not the rendered file.
# The prod configuration is a separate template (Caddyfile.prod.tmpl) rather
# than a set of conditionals here, because dev and prod genuinely differ:
# prod REQUIRES basic auth and a real certificate authority, and check-env
# refuses a prod boot without them. Two clear files beat one clever one.
#
# *.localhost resolves to 127.0.0.1 with no hosts-file edit, and Caddy issues
# every UI's certificate from the home's web CA (certs/web/, generated by
# scripts/certs, design.md D-112), so every UI is HTTPS from the first boot.
# `dbpantry certs trust` installs that CA's root once and browsers trust the
# UIs; it survives a recreated caddy_data volume, unlike a CA Caddy makes.
#
# These certificates are for the web UIs only. Database TLS is a separate
# concern with its own CA (SPEC section 9.1); engines never share these certs.

{
	admin off

	# Layer-4 routes for the database engines, generated by scripts/gen-compose
	# from the engine descriptors when MDB_PUBLISH=proxy. The file always
	# exists -- empty in the other modes -- because Caddy fails to start on a
	# missing import, and a front door that will not start is worse than one
	# that forwards nothing.
	import /etc/caddy/layer4.caddy

	# The home's web CA, not one Caddy generates in its volume (D-112). Caddy
	# holds the root certificate and the intermediate pair; the root key stays
	# in certs/web/ on the host. Its own id, not "local": Caddy files issued
	# certificates by CA id and serves a cached valid one first, so an
	# upgraded install kept the old CA's certificates under "local".
	pki {
		ca dbpantry {
			name "dbpantry local web CA"
			root {
				format pem_file
				cert /etc/caddy/web-ca/root.crt
			}
			intermediate {
				format pem_file
				cert /etc/caddy/web-ca/intermediate.crt
				key /etc/caddy/web-ca/intermediate.key
			}
		}
	}
	# Trust is installed on the host by `dbpantry certs trust`; inside the
	# container there is no store worth writing to.
	skip_install_trust

	# Caddy's own redirect targets port 443 inside the container, which is
	# not the published one when MDB_CADDY_HTTPS_PORT moves it; the http://
	# block below redirects to the published port instead.
	auto_https disable_redirects
}

(mdb_ui) {
	tls {
		issuer internal {
			ca dbpantry
		}
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# same-origin, not no-referrer: pgAdmin refuses every API call without a
		# same-origin Referer ("Failed to load preferences"); nothing is sent
		# to another site either way.
		Referrer-Policy same-origin
		-Server
	}
}

adminer.${MDB_UI_DOMAIN:-db.localhost} {
	import mdb_ui
	reverse_proxy adminer:8080
}

pma.${MDB_UI_DOMAIN:-db.localhost} {
	import mdb_ui
	reverse_proxy phpmyadmin:80
}

pgadmin.${MDB_UI_DOMAIN:-db.localhost} {
	import mdb_ui
	reverse_proxy pgadmin:80
}

# http:// on the published HTTP port goes to https:// on the published HTTPS
# port ({host} carries no port).
http://adminer.${MDB_UI_DOMAIN:-db.localhost}, http://pma.${MDB_UI_DOMAIN:-db.localhost}, http://pgadmin.${MDB_UI_DOMAIN:-db.localhost} {
	redir https://{host}:${MDB_CADDY_HTTPS_PORT:-443}{uri} permanent
}
