#!/usr/bin/env bash
#
# Rotate every database password and secret file, applied live (SPEC section 9).
#
# ORDER MATTERS MORE THAN ANYTHING ELSE HERE. If the file and the database ever
# disagree, the stack has locked itself out of its own data, and the recovery
# involves editing a volume by hand. So for each secret:
#
#   1. generate the new password into a TEMPORARY file
#   2. change it in the database
#   3. only then move the temp file into place, atomically
#
# If step 2 fails, the file is untouched and the old password still works. The
# window where the two could disagree is a single mv, which is atomic on the
# same filesystem.
#
# Usage: scripts/rotate-secrets [--yes]

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=backend-lib.sh
. "$ROOT/scripts/backend-lib.sh"
cd "$ROOT" || exit 1

log() { printf '[rotate-secrets] %s\n' "$*"; }
die() { printf '[rotate-secrets] ERROR: %s\n' "$*" >&2; exit 1; }

YES=0
[[ "${1:-}" == "--yes" ]] && YES=1

running() { mdb_be_running | grep -qx "$1"; }

# Publish secrets/ to the backend: a no-op on Compose and Incus (the files are
# bind-mounted), the dbpantry Secrets on Kubernetes. It matters most for a
# CloudNativePG Cluster, whose operator keeps the superuser password equal to
# its basic-auth Secret: left on the old value, the operator would put the old
# password back and the file and the database would disagree.
publish_secrets() {
    mdb_be_secrets_sync \
        || die "the new passwords are live in the database and in secrets/, but publishing
       them to the $MDB_BACKEND backend failed; run it again with: make up"
}

new_password() {
    openssl rand -base64 96 | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-40
}

engines=()
for e in pg mysql mariadb; do running "$e" && engines+=("$e"); done

if (( ${#engines[@]} == 0 )); then
    die "no engines are running. Rotation changes passwords IN the database, so
       the database has to be up. Run 'make up' first."
fi

printf '\n'
printf 'About to rotate passwords for: %s\n' "${engines[*]}"
printf 'Applications using the current passwords will need the new ones from secrets/.\n\n'

if (( ! YES )); then
    printf 'Type ROTATE to continue: '
    read -r answer
    [[ "$answer" == "ROTATE" ]] || die "confirmation did not match; nothing was changed"
fi

rotated=0
failed=0

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
if running pg; then
    tmp="$(mktemp)"
    new_password > "$tmp"
    new_pw="$(cat "$tmp")"

    # ALTER ROLE first, file second. psql is given the password via a here-doc
    # rather than the command line so it never reaches the process list.
    if mdb_svc_exec pg psql -U postgres -q <<SQL >/dev/null 2>&1
ALTER ROLE postgres WITH PASSWORD '${new_pw}';
SQL
    then
        chmod 0600 "$tmp"
        mv "$tmp" secrets/pg_superuser_password.txt
        log "rotated the PostgreSQL superuser password"
        rotated=$(( rotated + 1 ))
        publish_secrets
    else
        rm -f "$tmp"
        die "could not change the PostgreSQL superuser password; nothing was written"
    fi

    # Project roles, discovered from the secret files that exist.
    for f in secrets/pg_*_user_password.txt; do
        [[ -e "$f" ]] || continue
        role="$(basename "$f" _password.txt)"; role="${role#pg_}"

        mdb_svc_exec pg psql -U postgres -tAc \
            "SELECT 1 FROM pg_roles WHERE rolname='$role'" 2>/dev/null | grep -q 1 || continue

        tmp="$(mktemp)"; new_password > "$tmp"; new_pw="$(cat "$tmp")"
        if mdb_svc_exec pg psql -U postgres -q <<SQL >/dev/null 2>&1
ALTER ROLE ${role} WITH PASSWORD '${new_pw}';
SQL
        then
            chmod 0600 "$tmp"; mv "$tmp" "$f"
            log "rotated $role"
            rotated=$(( rotated + 1 ))
        else
            rm -f "$tmp"
            failed=$(( failed + 1 ))
            log "WARNING: could not rotate $role; its file is unchanged"
        fi
    done
fi

# -----------------------------------------------------------------------------
# MySQL family
# -----------------------------------------------------------------------------
#
# Every statement authenticates as root with the root password AS IT IS NOW:
# the file, re-read after root is rotated. This used to log in with the
# USER's freshly generated password, which root does not have, so every
# project user failed with a warning and kept its old password.
#
# The SQL, which carries the new password, goes in on stdin rather than in
# -e, so the new password never reaches a process list. A user is altered at
# EVERY host it exists at (root is both 'root'@'localhost' and 'root'@'%'):
# changing one left the other accepting the old password over TCP.

# Only plain identifiers are interpolated into SQL; anything else is skipped.
_valid_user() { [[ "$1" =~ ^[A-Za-z0-9_]+$ ]]; }

_my_root() {
    local engine="$1" client="$2"; shift 2
    mdb_svc_exec "$engine" "$client" -uroot -p"$(tr -d '\n' < "secrets/${engine}_root_password.txt")" \
        --protocol=socket -N -B "$@"
}

# ALTER USER at every host, as one statement list on stdin.
_my_alter_all_hosts() {
    local engine="$1" client="$2" user="$3" pw="$4" hosts h sql=""
    hosts="$(_my_root "$engine" "$client" -e "SELECT Host FROM mysql.user WHERE User='${user}'" 2>/dev/null | tr -d '\r')" \
        || return 1
    [[ -n "$hosts" ]] || return 2
    while IFS= read -r h; do
        [[ -n "$h" ]] || continue
        [[ "$h" =~ ^[A-Za-z0-9_.%:-]+$ ]] || continue
        sql+="ALTER USER '${user}'@'${h}' IDENTIFIED BY '${pw}';"$'\n'
    done <<<"$hosts"
    [[ -n "$sql" ]] || return 2
    printf '%sFLUSH PRIVILEGES;\n' "$sql" | _my_root "$engine" "$client" >/dev/null 2>&1
}

for engine in mysql mariadb; do
    running "$engine" || continue
    client="$( [[ "$engine" == mysql ]] && printf 'mysql' || printf 'mariadb' )"

    tmp="$(mktemp)"; new_password > "$tmp"; new_pw="$(cat "$tmp")"

    if _my_alter_all_hosts "$engine" "$client" root "$new_pw"; then
        chmod 0600 "$tmp"
        mv "$tmp" "secrets/${engine}_root_password.txt"
        log "rotated the $engine root password"
        rotated=$(( rotated + 1 ))
    else
        rm -f "$tmp"
        die "could not change the $engine root password; nothing was written"
    fi

    # Project owners and their read-only companions (scripts/new-project).
    for f in "secrets/${engine}"_*_user_password.txt "secrets/${engine}"_*_user_readonly_password.txt; do
        [[ -e "$f" ]] || continue
        user="$(basename "$f" _password.txt)"; user="${user#"${engine}"_}"
        if ! _valid_user "$user"; then
            log "WARNING: skipping $f: '$user' is not a plain user name"
            continue
        fi

        tmp="$(mktemp)"; new_password > "$tmp"; new_pw="$(cat "$tmp")"
        rc=0; _my_alter_all_hosts "$engine" "$client" "$user" "$new_pw" || rc=$?
        if (( rc == 0 )); then
            chmod 0600 "$tmp"; mv "$tmp" "$f"
            log "rotated $user"
            rotated=$(( rotated + 1 ))
        elif (( rc == 2 )); then
            rm -f "$tmp"
            log "skipping $user: no such $engine user (its file is unchanged)"
        else
            rm -f "$tmp"
            failed=$(( failed + 1 ))
            log "WARNING: could not rotate $user; its file is unchanged"
        fi
    done
done

publish_secrets

printf '\n'
log "rotated $rotated secret(s)"
# A user left on its old password is a failed rotation, not a footnote.
(( failed == 0 )) || die "$failed user(s) could not be rotated; see the warnings above"

cat <<'NOTE'

The new passwords are live in the database and on disk in secrets/.

  - Applications hold the OLD password until you update them. Read the new
    one from the matching file in secrets/.
  - No restart is needed: the engines authenticate against their own
    catalogues, not against the files.
  - The files are what a container reads at NEXT start, so they and the
    database now agree.
NOTE
