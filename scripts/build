#!/usr/bin/env bash
#
# Build the dbpantry images for this architecture.
#
# Bases come from images/bases.tsv, the single source of truth for what every
# image is built FROM, so a digest is never written twice.
#
# bases.tsv holds MAINTAINED versions only (design.md D-57). Any other version
# builds from MDB_<ENGINE>_BASE_IMAGE in .env, digest-pinned. Such an image is
# UNSUPPORTED: it is labelled so, the build says so, and nothing here scans or
# verifies it.
#
# Usage: scripts/build [engine ...]     (default: every engine with a Dockerfile)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=backend-lib.sh
. "$ROOT/scripts/backend-lib.sh"
cd "$ROOT" || exit 1

ENV_FILE="${MDB_ENV_FILE:-$ROOT/.env}"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$ROOT/.env.example"

PREFIX="${MDB_IMAGE_PREFIX:-ghcr.io/simtabi}"

get() { mdb_env_get "$1" "$ENV_FILE"; }

# shellcheck source=engine-lib.sh
. "$ROOT/scripts/engine-lib.sh"

# The version for an engine is MDB_<ENGINE>_VERSION from .env, defaulting to
# whatever the descriptor declares. No engine names appear here.
version_for() {
    local engine="$1" upper v
    if [ "$engine" = "cli" ]; then printf 'dev'; return; fi
    upper="$(printf '%s' "$engine" | tr '[:lower:]-' '[:upper:]_')"
    v="$(get "MDB_${upper}_VERSION")"
    if [ -n "$v" ]; then printf '%s' "$v"; return; fi
    ( engine_load "$engine" >/dev/null 2>&1 && printf '%s' "$MDB_ENGINE_DEFAULT_VERSION" )
}

base_for() {
    awk -v e="$1" -v v="$2" '$1==e && $2==v {print $3; exit}' "$ROOT/images/bases.tsv"
}

# MDB_<ENGINE>_BASE_IMAGE from .env, or nothing. Not for the cli image, which
# is not an engine and has no version menu.
base_override_for() {
    [ "$1" = "cli" ] && return 0
    get "$(engine_base_override_var "$1")"
}

# Captured BEFORE the list is filled in, because by then it is never empty.
EXPLICIT_ENGINES=$#

# Derived images (pgbouncer, patroni) may be NAMED explicitly. They are not
# engines, so the engine loop below cannot build them -- and before this split
# `scripts/build pgbouncer` matched nothing, built zero images and exited 0,
# which reads exactly like success. An image name you typed either builds or
# fails; it never no-ops.
engines=()
explicit_derived=""
for a in "$@"; do
    case "$a" in
        pgbouncer|patroni) explicit_derived="$explicit_derived $a" ;;
        *) engines+=("$a") ;;
    esac
done
if [[ $# -eq 0 ]]; then
    for e in $(engine_list) cli; do
        [[ -f "$ROOT/images/$e/Dockerfile" ]] && engines+=("$e")
    done
fi

# ${#engines[@]} on an empty array trips `set -u` on bash 3.2 (macOS), so the
# count goes through the ${arr[@]+...} guard the harness already uses elsewhere.
engine_count=0
for _e in ${engines[@]+"${engines[@]}"}; do engine_count=$(( engine_count + 1 )); done
if [[ "$engine_count" -eq 0 && -z "$explicit_derived" ]]; then
    printf 'no images have a Dockerfile yet\n' >&2
    exit 1
fi

for engine in ${engines[@]+"${engines[@]}"}; do
    [[ -f "$ROOT/images/$engine/Dockerfile" ]] \
        || { printf 'images/%s/Dockerfile does not exist\n' "$engine" >&2; exit 1; }

    version="$(version_for "$engine")"
    tag="$PREFIX/dbpantry-$engine:$version"

    # The build context is images/, not images/<engine>/, so the MySQL and
    # MariaDB images can share one set of init scripts (images/_shared).
    support_args=()
    base="$(base_override_for "$engine")"
    if [[ -n "$base" ]]; then
        engine_valid_base_ref "$base" || {
            printf '%s=%s is not pinned by digest; use name:tag@sha256:<digest>\n' \
                "$(engine_base_override_var "$engine")" "$base" >&2
            exit 1
        }
        printf 'WARNING: %s %s builds from %s (%s).\n  UNSUPPORTED: not built, scanned or verified by dbpantry; no scan guarantee.\n' \
            "$engine" "$version" "$base" "$(engine_base_override_var "$engine")" >&2
        support_args=(--build-arg "UNSUPPORTED_VERSION=true"
                      --label "io.simtabi.dbpantry.support=unsupported")
    else
        base="$(base_for "$engine" "$version")"
        [[ -n "$base" ]] || {
            printf 'no base pinned for %s %s in images/bases.tsv.\n' "$engine" "$version" >&2
            printf '  %s is not a maintained version (docs/guides/versions.md). To build it anyway, set\n' "$version" >&2
            printf '  %s in .env to its upstream image pinned by digest; it is then\n' "$(engine_base_override_var "$engine")" >&2
            printf '  unsupported, with no scan guarantee.\n' >&2
            exit 1
        }
    fi

    # The Go toolchain for the gotools stage (D-51), from the same file as the base.
    go_image="$(base_for toolchain go)"
    [[ -n "$go_image" ]] || {
        printf 'no Go toolchain pinned (row "toolchain go") in images/bases.tsv\n' >&2
        exit 1
    }

    printf 'building %s\n  from %s\n' "$tag" "$base"
    mdb_build \
        -f "$ROOT/images/$engine/Dockerfile" \
        --build-arg "BASE_IMAGE=$base" \
        --build-arg "GO_IMAGE=$go_image" \
        --build-arg "ENGINE_VERSION=$version" \
        ${support_args[@]+"${support_args[@]}"} \
        -t "$tag" "$ROOT/images"
done

# ---------------------------------------------------------------------------
# Derived images, built last because their base is one of ours.
#
# The Patroni image is FROM dbpantry-pg, so an HA node is the same PostgreSQL
# as a standalone one -- same extensions, same hardening. That also means it has
# no entry in images/bases.tsv, which holds digest-pinned UPSTREAM references
# and would be the wrong place to name an image we just built.
#
# Built here rather than left to `docker compose up --build`, because a compose
# auto-build happens inside whichever check first needs it, where a build
# failure surfaces as that check timing out.
# Derived images are built ONLY in a full build.
#
# They are FROM images this script produces -- patroni is FROM
# dbpantry-pg -- so building them during `scripts/build cassandra`
# makes Docker look for a base that exists nowhere but a full local build.
# In CI, where each matrix job builds one engine, that surfaced as a 403 from
# ghcr for an image we have never published.
derived=0
if (( EXPLICIT_ENGINES == 0 )); then
    build_derived=1        # full build: everything, including derived
else
    build_derived=0        # explicit engines only -- unless a derived image was named
fi
case " $explicit_derived " in *" pgbouncer "*) build_pgbouncer=1 ;; *) build_pgbouncer=$build_derived ;; esac
case " $explicit_derived " in *" patroni "*)   build_patroni=1   ;; *) build_patroni=$build_derived   ;; esac

if (( build_pgbouncer )) && [[ -f "$ROOT/images/pgbouncer/Dockerfile" ]]; then
    tag="$PREFIX/dbpantry-pgbouncer:dev"
    printf 'building %s\n  from docker.io/library/debian:12-slim + PGDG\n' "$tag"
    mdb_build -f "$ROOT/images/pgbouncer/Dockerfile" -t "$tag" "$ROOT/images"
    derived=$(( derived + 1 ))
fi

if (( build_patroni )) && [[ -f "$ROOT/images/patroni/Dockerfile" ]]; then
    pg_version="$(version_for pg)"
    tag="$PREFIX/dbpantry-patroni:$pg_version"
    printf 'building %s\n  from %s/dbpantry-pg:%s\n' "$tag" "$PREFIX" "$pg_version"
    mdb_build \
        -f "$ROOT/images/patroni/Dockerfile" \
        --build-arg "ENGINE_VERSION=$pg_version" \
        --build-arg "IMAGE_PREFIX=$PREFIX" \
        -t "$tag" "$ROOT/images"
    derived=$(( derived + 1 ))
fi

printf '✓ built %d image(s)\n' "$(( engine_count + derived ))"
