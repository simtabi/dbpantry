#!/usr/bin/env bash
#
# Render a Helm values file for deploy/helm/dbpantry from .env, so .env stays
# the one place a checkout is configured on every backend (design.md D-64).
#
#   scripts/helm-values            values YAML on stdout
#   scripts/helm-values -o FILE    write it to FILE (mode 0600)
#
# What it maps:
#   MDB_PROFILES                 which engines are enabled (pg, mysql, mariadb,
#                                mongodb, cassandra; other profiles are not on
#                                Kubernetes yet and are reported on stderr)
#   MDB_<ENGINE>_VERSION         the image tag
#   MDB_MONGODB_IMAGE / _BASE_IMAGE  MongoDB's image reference
#   MDB_<ENGINE>_MEM_LIMIT / _CPU_LIMIT  memory and cpu (requests and limits)
#   MDB_PG_SHM                   the size of PostgreSQL's /dev/shm
#   MDB_K8S_STORAGE_CLASS        global.storageClass
#   the ha profile               PostgreSQL HA (engines.pg.ha): Patroni, or
#                                CloudNativePG with MDB_K8S_HA_PROVIDER=cnpg;
#                                MDB_HA_CLUSTER_NAME, MDB_PG_SYNC_MODE,
#                                MDB_K8S_HA_REPLICAS
#   the backup profile           backup CronJobs (backup.*): MDB_BACKUP_SCHEDULE
#                                (HHMM, daily) or MDB_K8S_BACKUP_SCHEDULE (cron),
#                                MDB_TZ as the time zone
#   every variable the engine's Compose service passes (its environment:
#   block in compose.engines.yml), resolved the way Compose resolves it: the
#   environment, then .env, then the ${VAR:-default} default. Empty values are
#   left out, and the /run/secrets password files come from the chart.
#
# Every value is emitted double-quoted, so YAML never retypes one (a version
# such as 8.4, or "false", stays a string).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=env-lib.sh
. "$ROOT/scripts/env-lib.sh"

ENGINES="pg mysql mariadb mongodb cassandra"
COMPOSE_ENGINES="${MDB_HELM_COMPOSE_FILE:-$ROOT/compose.engines.yml}"
ENV_FILE="${MDB_HELM_ENV_FILE:-$ROOT/.env}"
out=""

while (( $# )); do
    case "$1" in
        -o) out="${2:?-o needs a file}"; shift 2 ;;
        -h|--help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) printf 'helm-values: unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
done

[[ -f "$COMPOSE_ENGINES" ]] || { printf 'helm-values: %s not found (run scripts/gen-compose)\n' "$COMPOSE_ENGINES" >&2; exit 1; }

# A setting as Compose sees it: the environment wins over .env.
setting() {
    local key="$1"
    if [[ -n "${!key+x}" ]]; then printf '%s' "${!key}"; return; fi
    mdb_env_get "$key" "$ENV_FILE"
}

# YAML double-quoted scalar.
q() {
    local v="$1"
    v="${v//\\/\\\\}"
    v="${v//\"/\\\"}"
    printf '"%s"' "$v"
}

upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

# KEY<TAB>EXPRESSION for every entry of one service's environment: block.
service_env() {
    awk -v svc="$1" '
        $0 ~ "^  " svc ":$" { insvc = 1; next }
        insvc && /^  [a-zA-Z0-9_-]+:$/ { exit }
        insvc && /^    environment:$/ { inenv = 1; next }
        inenv && /^    [a-z_]+:/ { exit }
        inenv && /^      [A-Za-z_][A-Za-z0-9_]*:/ {
            line = $0; sub(/^      /, "", line)
            key = line; sub(/:.*/, "", key)
            val = line; sub(/^[^:]*:[ ]*/, "", val)
            printf "%s\t%s\n", key, val
        }
    ' "$COMPOSE_ENGINES"
}

# Resolve one Compose value: ${VAR:-default}, ${VAR}, or a literal.
resolve() {
    local expr="$1" var def v
    if [[ "$expr" =~ ^\$\{([A-Za-z_][A-Za-z0-9_]*)(:-(.*))?\}$ ]]; then
        var="${BASH_REMATCH[1]}"; def="${BASH_REMATCH[3]}"
        v="$(setting "$var")"
        printf '%s' "${v:-$def}"
        return
    fi
    expr="${expr#\"}"; expr="${expr%\"}"
    printf '%s' "$expr"
}

# The same precedence as scripts/render-config.
profiles="${COMPOSE_PROFILES:-$(setting MDB_PROFILES)}"
profiles="${profiles:-pg,ui}"
profiles=",${profiles// /},"

has_profile() { case "$profiles" in *",$1,"*) return 0 ;; esac; return 1; }

# PostgreSQL HA. Its own profile, as under Compose (`make up PROFILES=pg,ha`).
render_ha() {
    local v
    printf '    ha:\n'
    if has_profile ha; then printf '      enabled: true\n'; else printf '      enabled: false\n'; fi
    v="$(setting MDB_K8S_HA_PROVIDER)"; v="${v:-patroni}"
    case "$v" in
        patroni|cnpg) ;;
        *) printf 'helm-values: MDB_K8S_HA_PROVIDER must be patroni or cnpg, not %s\n' "$v" >&2; return 1 ;;
    esac
    printf '      provider: %s\n' "$(q "$v")"
    v="$(setting MDB_HA_CLUSTER_NAME)"; [[ -z "$v" ]] || printf '      clusterName: %s\n' "$(q "$v")"
    v="$(setting MDB_PG_SYNC_MODE)"; [[ -z "$v" ]] || printf '      syncMode: %s\n' "$(q "$v")"
    v="$(setting MDB_K8S_HA_REPLICAS)"
    if [[ -n "$v" ]]; then
        [[ "$v" =~ ^[0-9]+$ ]] || { printf 'helm-values: MDB_K8S_HA_REPLICAS must be a number, not %s\n' "$v" >&2; return 1; }
        printf '      replicas: %s\n' "$(q "$v")"
    fi
}

# MDB_BACKUP_SCHEDULE is HHMM, daily (0300); a cron line overrides it.
render_backup() {
    local v hh mm
    printf 'backup:\n'
    if has_profile backup; then printf '  enabled: true\n'; else printf '  enabled: false\n'; fi
    v="$(setting MDB_K8S_BACKUP_SCHEDULE)"
    if [[ -z "$v" ]]; then
        v="$(setting MDB_BACKUP_SCHEDULE)"; v="${v:-0300}"
        [[ "$v" =~ ^([0-2][0-9])([0-5][0-9])$ ]] \
            || { printf 'helm-values: MDB_BACKUP_SCHEDULE must be HHMM, not %s (or set MDB_K8S_BACKUP_SCHEDULE to a cron line)\n' "$v" >&2; return 1; }
        hh=$((10#${BASH_REMATCH[1]})); mm=$((10#${BASH_REMATCH[2]}))
        v="$mm $hh * * *"
    fi
    printf '  schedule: %s\n' "$(q "$v")"
    v="$(setting MDB_TZ)"; [[ -z "$v" ]] || printf '  timeZone: %s\n' "$(q "$v")"
    v="$(setting MDB_K8S_BACKUP_STORAGE)"; v="${v:-20Gi}"
    printf '  storage: %s\n' "$(q "$v")"
    # The backend creates the claims: see backup.createClaims in values.yaml.
    printf '  createClaims: false\n'
}

render() {
    local sc eng ENG enabled v mem cpu key expr val
    printf '# Rendered by scripts/helm-values from %s. Do not edit: change .env.\n' "$(basename "$ENV_FILE")"
    sc="$(setting MDB_K8S_STORAGE_CLASS)"
    printf 'global:\n'
    printf '  storageClass: %s\n' "$(q "$sc")"
    printf 'engines:\n'
    for eng in $ENGINES; do
        ENG="$(upper "$eng")"
        enabled=false
        case "$profiles" in *",$eng,"*) enabled=true ;; esac
        printf '  %s:\n' "$eng"
        printf '    enabled: %s\n' "$enabled"
        if [[ "$eng" == mongodb ]]; then
            v="$(setting MDB_MONGODB_IMAGE)"; [[ -n "$v" ]] || v="$(setting MDB_MONGODB_BASE_IMAGE)"
            [[ -z "$v" ]] || printf '    imageRef: %s\n' "$(q "$v")"
        else
            v="$(setting "MDB_${ENG}_VERSION")"
            [[ -z "$v" ]] || printf '    tag: %s\n' "$(q "$v")"
        fi
        mem="$(setting "MDB_${ENG}_MEM_LIMIT")"
        cpu="$(setting "MDB_${ENG}_CPU_LIMIT")"
        [[ -z "$mem" ]] || printf '    memory: %s\n' "$(q "$mem")"
        [[ -z "$cpu" ]] || printf '    cpu: %s\n' "$(q "$cpu")"
        if [[ "$eng" == pg ]]; then
            v="$(setting MDB_PG_SHM)"
            [[ -z "$v" ]] || printf '    shm: %s\n' "$(q "$v")"
            render_ha
        fi
        printf '    env:\n'
        while IFS=$'\t' read -r key expr; do
            [[ -n "$key" ]] || continue
            # The chart sets the memory variable from memory, and mounts the
            # password files itself.
            [[ "$key" == "MDB_${ENG}_MEM_LIMIT" ]] && continue
            val="$(resolve "$expr")"
            [[ -n "$val" ]] || continue
            [[ "$val" == /run/secrets/* ]] && continue
            printf '      %s: %s\n' "$key" "$(q "$val")"
        done < <(service_env "$eng")
    done
    render_backup
}

# Profiles that have no Kubernetes workload yet.
skipped=""
IFS=, read -r -a plist <<<"${profiles//,,/,}"
for p in ${plist[@]+"${plist[@]}"}; do
    [[ -n "$p" ]] || continue
    case " $ENGINES ha backup " in *" $p "*) ;; *) skipped="${skipped:+$skipped, }$p" ;; esac
done
if has_profile ha && ! has_profile pg; then
    printf 'helm-values: the ha profile needs pg too (MDB_PROFILES="pg,ha")\n' >&2
fi
[[ -z "$skipped" ]] || printf 'helm-values: not deployed on Kubernetes yet: %s (docs/guides/kubernetes.md)\n' "$skipped" >&2

if [[ -n "$out" ]]; then
    ( umask 077; render >"$out" )
else
    render
fi
