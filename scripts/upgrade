#!/usr/bin/env bash
#
# Guided major-version migration (SPEC section 4).
#
# The dump-and-restore path, which is the default because it is the one that
# always works: it crosses any version gap, it is verifiable before you commit
# to it, and the OLD VOLUME IS NEVER TOUCHED. Per-major volumes (decision 2)
# are what make that true -- the old major keeps its own volume, so a failed
# upgrade is a non-event and rollback is changing one line in .env back.
#
# pg_upgrade --link is faster on large datasets and is documented in
# docs/runbooks/upgrade.md as the manual path; it is not automated here because it
# mutates the source data directory, which would throw away that guarantee.
#
# Usage: scripts/upgrade --engine pg --from 17 --to 18
#
# FROM may be a version that is no longer maintained (design.md D-57) -- that is
# the usual reason to upgrade. Its image then has to be built from
# MDB_<ENGINE>_BASE_IMAGE first; the error below says how.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=backend-lib.sh
. "$ROOT/scripts/backend-lib.sh"
cd "$ROOT" || exit 1
# A major upgrade runs the old and new server side by side on Compose volumes.
mdb_backend_require compose || exit 64

PROJECT="$(mdb_project_name)"
PREFIX="${MDB_IMAGE_PREFIX:-ghcr.io/simtabi}"
WORK="$ROOT/backups/upgrade"

log() { printf '[upgrade] %s\n' "$*"; }
die() { printf '[upgrade] ERROR: %s\n' "$*" >&2; exit 1; }

ENGINE=""; FROM=""; TO=""
ENGINE_UPPER=""
while (( $# )); do
    case "$1" in
        --engine) ENGINE="${2:-}"; shift 2 ;;
        --from)   FROM="${2:-}"; shift 2 ;;
        --to)     TO="${2:-}"; shift 2 ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ -n "$ENGINE" && -n "$FROM" && -n "$TO" ]] \
    || die "usage: make upgrade ENGINE=pg FROM=17 TO=18"
[[ "$FROM" != "$TO" ]] || die "FROM and TO are the same version"

case "$ENGINE" in
    pg)      vol_from="${PROJECT}_pg${FROM}_data";      vol_to="${PROJECT}_pg${TO}_data" ;;
    mysql)   vol_from="${PROJECT}_mysql${FROM}_data";   vol_to="${PROJECT}_mysql${TO}_data" ;;
    mariadb) vol_from="${PROJECT}_mariadb${FROM}_data"; vol_to="${PROJECT}_mariadb${TO}_data" ;;
    *) die "unknown engine: $ENGINE" ;;
esac

# Where PostgreSQL's data volume mounts. PG 18 moved it one level up, to
# /var/lib/postgresql, so a dump from 17 restored into 18 at the old path would
# initialise into an anonymous volume and leave the new one empty.
pg_mount() {
    if (( ${1%%.*} >= 18 )); then printf '/var/lib/postgresql'; else printf '/var/lib/postgresql/data'; fi
}

# tr rather than ${ENGINE^^}: that expansion is bash 4 only and macOS ships
# bash 3.2, where it is a syntax error (design.md D-24).
ENGINE_UPPER="$(printf '%s' "$ENGINE" | tr '[:lower:]' '[:upper:]')"

mdb_ctr volume inspect "$vol_from" >/dev/null 2>&1 \
    || die "no data volume for $ENGINE $FROM ($vol_from); nothing to upgrade from"

# Both images must already be local. Without this the first docker run tries to
# pull from a private registry and fails with a bare "denied", which says
# nothing about what is actually wrong.
for v in "$FROM" "$TO"; do
    img="$PREFIX/dbpantry-$ENGINE:$v"
    mdb_ctr image inspect "$img" >/dev/null 2>&1 \
        || die "image not built: $img
       Build it first: set MDB_${ENGINE_UPPER}_VERSION=$v in .env and run
       scripts/build $ENGINE. A version that is no longer maintained also
       needs MDB_${ENGINE_UPPER}_BASE_IMAGE (docs/guides/versions.md)."
done

cat <<PLAN

Upgrade plan
────────────────────────────────────────────────────────────────────────
  engine        ${ENGINE}
  from          ${FROM}   (volume ${vol_from})
  to            ${TO}     (volume ${vol_to})
  method        dump and restore

  The ${FROM} volume is NEVER modified. If anything goes wrong, set
  MDB_${ENGINE_UPPER}_VERSION back to ${FROM} in .env and you are exactly
  where you started.
────────────────────────────────────────────────────────────────────────

PLAN

if [[ "${CONFIRM:-}" != "yes" ]]; then
    printf 'Type the target version (%s) to continue: ' "$TO"
    read -r answer
    [[ "$answer" == "$TO" ]] || die "confirmation did not match; nothing was changed"
fi

mkdir -p "$WORK"
stamp="$(date -u '+%Y%m%dT%H%M%SZ')"

old_c="mdb-upgrade-from-$$"
new_c="mdb-upgrade-to-$$"
cleanup() { mdb_ctr rm -f -v "$old_c" "$new_c" >/dev/null 2>&1 || true; }
trap cleanup EXIT

# ---------------------------------------------------------------------------
# 1. Dump from the old major, in an isolated container so the running stack is
#    untouched.
# ---------------------------------------------------------------------------
log "starting $ENGINE $FROM against its existing volume (read only as far as your data is concerned)"

case "$ENGINE" in
    pg)
        mdb_ctr run -d --name "$old_c" -e POSTGRES_PASSWORD=mdb-throwaway-upgrade \
            -v "$vol_from:$(pg_mount "$FROM")" "$PREFIX/dbpantry-pg:$FROM" >/dev/null \
            || die "could not start $ENGINE $FROM"
        for _ in $(seq 1 120); do
            mdb_ctr exec "$old_c" pg_isready -U postgres >/dev/null 2>&1 && break
            sleep 1
        done
        sleep 3

        dump="$WORK/${ENGINE}${FROM}_all_${stamp}.sql"
        log "dumping every database and the globals"
        mdb_ctr exec "$old_c" pg_dumpall -U postgres > "$dump" \
            || die "dump failed; nothing has been changed"
        ;;
    mysql|mariadb)
        pw_env="$( [[ "$ENGINE" == mysql ]] && printf 'MYSQL_ROOT_PASSWORD' || printf 'MARIADB_ROOT_PASSWORD' )"
        client="$( [[ "$ENGINE" == mysql ]] && printf 'mysql' || printf 'mariadb' )"
        dumper="$( [[ "$ENGINE" == mysql ]] && printf 'mysqldump' || printf 'mariadb-dump' )"
        root_pw="$(cat "secrets/${ENGINE}_root_password.txt")"

        mdb_ctr run -d --name "$old_c" -e "$pw_env=$root_pw" \
            -v "$vol_from:/var/lib/mysql" "$PREFIX/dbpantry-$ENGINE:$FROM" >/dev/null \
            || die "could not start $ENGINE $FROM"
        for _ in $(seq 1 180); do
            mdb_ctr exec "$old_c" "$client" -uroot -p"$root_pw" -e "SELECT 1" >/dev/null 2>&1 && break
            sleep 1
        done

        dump="$WORK/${ENGINE}${FROM}_all_${stamp}.sql"
        log "dumping every database, with routines and events"
        mdb_ctr exec "$old_c" "$dumper" -uroot -p"$root_pw" \
            --all-databases --single-transaction --routines --triggers --events --quick \
            > "$dump" 2>/dev/null || die "dump failed; nothing has been changed"
        ;;
esac

[[ -s "$dump" ]] || die "the dump is empty; refusing to continue"
log "dumped $(du -h "$dump" | cut -f1) to ${dump#"$ROOT"/}"
mdb_ctr rm -f -v "$old_c" >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# 2. Restore into a fresh volume for the new major.
# ---------------------------------------------------------------------------
log "starting $ENGINE $TO on a fresh volume"

# The restore used to end in `|| true`, so a client that could not connect, or
# stopped at the first error, still led to "Upgrade staged successfully" over a
# partial copy whenever at least one database had made it across.
errlog="$WORK/${ENGINE}${TO}_restore_${stamp}.log"
restore_failed() {
    grep -v 'Using a password on the command line' "$errlog" | tail -n 20 >&2 || true
    die "restore into $ENGINE $TO failed (full log: ${errlog#"$ROOT"/}).
       The OLD volume $vol_from is untouched, so nothing is lost; the partial
       $vol_to can be removed with: make destroy --volume $vol_to"
}

case "$ENGINE" in
    pg)
        mdb_ctr run -d --name "$new_c" -e POSTGRES_PASSWORD=mdb-throwaway-upgrade \
            -v "$vol_to:$(pg_mount "$TO")" "$PREFIX/dbpantry-pg:$TO" >/dev/null \
            || die "could not start $ENGINE $TO"
        for _ in $(seq 1 120); do
            mdb_ctr exec "$new_c" pg_isready -U postgres >/dev/null 2>&1 && break
            sleep 1
        done
        sleep 3
        log "restoring"
        # Without ON_ERROR_STOP psql reports statement errors (the role
        # "postgres" already exists, say) and carries on, which is wanted; a
        # non-zero exit means it could not connect or read the dump at all.
        mdb_ctr exec -i "$new_c" psql -U postgres -q < "$dump" >/dev/null 2>"$errlog" \
            || restore_failed

        count="$(mdb_ctr exec "$new_c" psql -U postgres -tAc \
            "SELECT count(*) FROM pg_database WHERE datallowconn AND NOT datistemplate" | tr -d ' ')"
        ;;
    mysql|mariadb)
        mdb_ctr run -d --name "$new_c" -e "$pw_env=$root_pw" \
            -v "$vol_to:/var/lib/mysql" "$PREFIX/dbpantry-$ENGINE:$TO" >/dev/null \
            || die "could not start $ENGINE $TO"
        for _ in $(seq 1 180); do
            mdb_ctr exec "$new_c" "$client" -uroot -p"$root_pw" -e "SELECT 1" >/dev/null 2>&1 && break
            sleep 1
        done
        log "restoring"
        mdb_ctr exec -i "$new_c" "$client" -uroot -p"$root_pw" < "$dump" >/dev/null 2>"$errlog" \
            || restore_failed

        count="$(mdb_ctr exec "$new_c" "$client" -uroot -p"$root_pw" -N -B -e \
            "SELECT count(*) FROM information_schema.schemata
             WHERE schema_name NOT IN ('information_schema','performance_schema','mysql','sys')" \
             2>/dev/null | tr -d ' \r')"
        ;;
esac

if [[ -z "$count" ]] || (( count == 0 )); then
    die "the upgraded server has no databases; the OLD volume $vol_from is untouched, so nothing is lost"
fi

log "$count database(s) present on $ENGINE $TO"

extra=""
if [[ "$ENGINE" == pg && "$(pg_mount "$FROM")" != "$(pg_mount "$TO")" ]]; then
    extra="     and MDB_PG_DATA_MOUNT=$(pg_mount "$TO") (PG 18 moved the data directory)
"
fi

cat <<DONE

────────────────────────────────────────────────────────────────────────
Upgrade staged successfully.

  1. Set MDB_${ENGINE_UPPER}_VERSION=${TO} in .env
${extra}     and remove MDB_${ENGINE_UPPER}_BASE_IMAGE if it was set for ${FROM}
  2. make up
  3. Verify your application

  The ${FROM} data is still in ${vol_from}. Keep it until you are sure.
  To roll back: set the version back to ${FROM} and make up.
  To reclaim the space later: make destroy --volume ${vol_from}

  The intermediate dump is at ${dump#"$ROOT"/}
────────────────────────────────────────────────────────────────────────
DONE
