#!/usr/bin/env bash
#
# Guided, confirmed restore (SPEC section 15.1).
#
# A restore overwrites a live database, so it asks before it does. CONFIRM=yes
# skips the prompt for automation. A dump whose checksum does not match is
# always refused. A dump with no .sha256 alongside is refused too, because
# nothing proves it is whole; MDB_RESTORE_ALLOW_UNVERIFIED=yes restores it
# anyway, for a dump you made by hand and trust.
#
# The exit status is the restore's. It used to end in `|| true` and log
# "complete" whatever happened, so a corrupt or truncated dump left an empty
# database behind a success message. A failure now prints the client's last
# lines and exits non-zero, saying the database was already recreated.
#
# Usage: scripts/restore --engine pg --db mydb --file backups/pg_mydb_...zst
#        CONFIRM=yes scripts/restore ...

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=backend-lib.sh
. "$ROOT/scripts/backend-lib.sh"
ENV_FILE="${MDB_ENV_FILE:-$ROOT/.env}"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$ROOT/.env.example"

get() { mdb_env_get "$1" "$ENV_FILE"; }
log() { printf '[restore] %s\n' "$*"; }
die() { printf '[restore] ERROR: %s\n' "$*" >&2; exit 1; }

ENGINE=""; DB=""; FILE=""
while (( $# )); do
    case "$1" in
        --engine) ENGINE="${2:-}"; shift 2 ;;
        --db)     DB="${2:-}"; shift 2 ;;
        --file)   FILE="${2:-}"; shift 2 ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ -n "$ENGINE" ]] || die "specify --engine <pg|mysql|mariadb>"
[[ -n "$DB" ]]     || die "specify --db <name>"
[[ -n "$FILE" ]]   || die "specify --file <path>"
[[ -f "$FILE" ]]   || die "no such file: $FILE"

IN_CONTAINER="${MDB_IN_CONTAINER:-0}"

engine_exec() {
    local engine="$1"; shift
    if [[ "$IN_CONTAINER" == "1" ]]; then
        "$@"
    else
        ( cd "$ROOT" && mdb_svc_exec "$engine" "$@" )
    fi
}

secret() {
    local file="$1"
    if [[ "$IN_CONTAINER" == "1" ]]; then
        tr -d '\n' < "/run/secrets/$file"
    else
        tr -d '\n' < "$ROOT/secrets/$file"
    fi
}

# compress_ext is part of the contract the family hooks are written against.
compress_ext() { case "$FILE" in *.zst) printf '.zst' ;; *) printf '' ;; esac; }

# Engine operations come from the descriptor and its family hooks
# (SPEC section 22.1); nothing below branches on an engine name.
# shellcheck source=engine-lib.sh
. "$ROOT/scripts/engine-lib.sh"
engine_load "$ENGINE" || die "unknown engine: $ENGINE"
engine_load_hooks || die "no hooks for engine family ${MDB_ENGINE_FAMILY:-?}"

# -----------------------------------------------------------------------------
# Integrity first. Restoring a corrupted dump over a live database is strictly
# worse than not restoring at all, so the checksum is verified before anything
# is touched. A mismatch can never be skipped; a missing checksum only with
# MDB_RESTORE_ALLOW_UNVERIFIED=yes.
# -----------------------------------------------------------------------------
if [[ -f "$FILE.sha256" ]]; then
    log "verifying checksum"
    if command -v sha256sum >/dev/null 2>&1; then
        ( cd "$(dirname "$FILE")" && sha256sum -c "$(basename "$FILE").sha256" ) >/dev/null \
            || die "checksum mismatch: $FILE is corrupt or truncated"
    else
        ( cd "$(dirname "$FILE")" && shasum -a 256 -c "$(basename "$FILE").sha256" ) >/dev/null \
            || die "checksum mismatch: $FILE is corrupt or truncated"
    fi
    log "checksum ok"
elif [[ "${MDB_RESTORE_ALLOW_UNVERIFIED:-}" == "yes" ]]; then
    log "WARNING: no checksum file alongside $FILE; restoring it unverified (MDB_RESTORE_ALLOW_UNVERIFIED=yes)"
else
    die "no checksum file alongside $FILE ($FILE.sha256), so nothing proves the dump is whole.
       Nothing was changed. To restore it anyway: MDB_RESTORE_ALLOW_UNVERIFIED=yes"
fi

# -----------------------------------------------------------------------------
# Confirmation
# -----------------------------------------------------------------------------
if [[ "${CONFIRM:-}" != "yes" ]]; then
    printf '\n'
    printf 'About to restore into %s database "%s".\n' "$ENGINE" "$DB"
    printf 'This REPLACES the current contents of that database.\n'
    printf '  source: %s\n\n' "$FILE"
    printf 'Type the database name to continue: '
    read -r answer
    [[ "$answer" == "$DB" ]] || die "confirmation did not match; nothing was changed"
fi

decompress() {
    case "$FILE" in
        *.zst) zstd -dc "$FILE" ;;
        *)     cat "$FILE" ;;
    esac
}

log "recreating database $DB"
hook_recreate_database "$DB" || die "could not recreate $DB"

# The client's stderr is kept for the failure path: the reason is in it, and
# nothing else records it.
log "restoring"
errlog="$(mktemp "${TMPDIR:-/tmp}/mdb-restore.XXXXXX")"
trap 'rm -f "$errlog"' EXIT
if ! decompress 2>"$errlog" | hook_restore_database "$DB" >/dev/null 2>>"$errlog"; then
    tail -20 "$errlog" | sed 's/^/[restore]   /' >&2
    die "restore of $DB FAILED. $DB was dropped and recreated first, so it is now
       empty or partial. Fix the cause above and restore again."
fi

log "restore of $DB complete"
