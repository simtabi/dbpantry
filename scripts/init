#!/usr/bin/env bash
#
# Initialise a dbpantry checkout: environment file, generated secrets, and the
# TLS certificates PostgreSQL needs in order to start at all (SPEC section 13).
#
# Idempotent, and refuses to overwrite an existing environment file without
# FORCE=1, because doing so would orphan every password already in use.
#
# Usage: scripts/init [--prod]

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=runtime-lib.sh
. "$ROOT/scripts/runtime-lib.sh"
cd "$ROOT" || exit 1

PROD=0
[[ "${1:-}" == "--prod" ]] && PROD=1

TARGET="$ROOT/.env"
(( PROD )) && TARGET="$ROOT/.env.prod"
[[ -n "${ENV_FILE:-}" ]] && TARGET="$ENV_FILE"

if [[ -f "$TARGET" ]] && [[ "${FORCE:-0}" != "1" ]]; then
    printf '%s already exists.\n' "${TARGET#"$ROOT"/}" >&2
    printf 'Refusing to overwrite it: the passwords in secrets/ are already in use\n' >&2
    printf 'by any database you have created. Re-run with FORCE=1 to replace it.\n' >&2
    exit 1
fi

# -----------------------------------------------------------------------------
# 1. Environment file
# -----------------------------------------------------------------------------
cp "$ROOT/.env.example" "$TARGET"
printf '✓ wrote %s\n' "${TARGET#"$ROOT"/}"

# -----------------------------------------------------------------------------
# 2. Secrets
# -----------------------------------------------------------------------------
mkdir -p "$ROOT/secrets"
chmod 0700 "$ROOT/secrets"

gen_secret() {
    name="$1"
    file="$ROOT/secrets/$name"
    if [[ -s "$file" ]]; then
        printf '  %s already exists, keeping it\n' "$name"
        return 0
    fi
    # Base64 minus the characters that need escaping in connection URIs and
    # configuration files, so a generated password never needs quoting.
    #
    # Sourced from `openssl rand` rather than /dev/urandom because the latter is
    # infinite: `head -c` would close the pipe, kill `tr` with SIGPIPE, and
    # `set -o pipefail` would turn that into a fatal error 141 after the file
    # had already been written but before it was chmodded.
    openssl rand -base64 96 | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-40 > "$file"
    chmod "${2:-0600}" "$file"
    printf '  generated %s\n' "$name"
}

printf 'generating secrets\n'

# Driven by the descriptors rather than a list maintained here. A hardcoded
# list is how MongoDB, Cassandra and FerretDB shipped with no generated secret:
# the engines were added, this list was not, and nothing said so.
# shellcheck source=engine-lib.sh
. "$ROOT/scripts/engine-lib.sh"
for engine in $(engine_list); do
    engine_load "$engine" || continue
    gen_secret "$MDB_ENGINE_ROOT_SECRET"
done

# HA roles. Generated unconditionally rather than only when MDB_HA_ENABLE is
# true: enabling HA later must not require re-running an init that refuses to
# run twice.
gen_secret pg_replication_password.txt
gen_secret patroni_rest_password.txt

# Poolers hold a credential of their own. pgBouncer never stores an application
# user's password -- it looks verifiers up with auth_query -- so this is the
# only one it has. See docs/guides/pooling.md.
gen_secret pgbouncer_password.txt

# ProxySQL's admin interface and its monitor account. Neither is an application
# credential: the admin password guards the interface that can read every
# verifier ProxySQL holds, which is why port 6032 is never published.
# The PITR repository is encrypted before it leaves the machine, so the
# passphrase is generated up front rather than when someone enables S3.
gen_secret pgbackrest_cipher_passphrase.txt

gen_secret proxysql_admin_password.txt
gen_secret proxysql_monitor_password.txt

# 0644, not 0600, and deliberately. pgAdmin is the only container that reads
# its secret as a NON-ROOT user (uid 5050) with no root phase to read it for
# them -- the engines and poolers all read as root and then drop. Compose
# ignores uid/gid/mode on file-backed secrets outside swarm (docker/compose
# #9648; the PR to fix it was closed unmerged), so the bind-mounted file
# arrives in the container with the HOST owner and mode, and 0600 owned by
# whoever ran make init is unreadable to uid 5050 on Linux: pgAdmin
# crash-looped and Caddy answered 502. On macOS ownership is flattened, which
# is why it never reproduced here. On the host nothing is exposed: secrets/
# itself is 0700, so the wider file mode is unreachable to other users.
gen_secret pgadmin_password.txt 0644
# Same reasoning would apply to any future secret consumed by a third-party
# image that starts unprivileged. Our own images read as root instead.

# -----------------------------------------------------------------------------
# 3. Certificates
# -----------------------------------------------------------------------------
# PostgreSQL TLS is always on (SPEC decision 5), so without certificates the
# stack cannot boot. Generating them here is what makes `make init && make up`
# actually two commands.
printf 'generating certificates\n'
MDB_ENV_FILE="$TARGET" "$ROOT/scripts/certs"

# -----------------------------------------------------------------------------
# 4. Prod hardening
# -----------------------------------------------------------------------------
if (( PROD )); then
    printf 'applying prod-safe values\n'

    # The UI password is generated here rather than left as a TODO, because
    # check-env refuses a prod boot without an auth hash and a placeholder
    # would simply move the failure later. The plaintext goes to secrets/ for
    # the operator; only the bcrypt hash reaches the env file.
    gen_secret ui_password.txt
    ui_password="$(cat "$ROOT/secrets/ui_password.txt")"

    # Found by SERVICE, not by a substring of the image name. The pattern used
    # to be /image: caddy:/, which stopped matching the moment the image became
    # one we build -- and the only symptom was "could not compute the UI
    # password hash (is the container runtime running? scripts/runtime info)", which blames Docker.
    caddy_image="$(awk '/^  caddy:/{f=1} f && /^[[:space:]]+image:/{print $2; exit}' \
        "$ROOT/docker-compose.yml")"
    ui_hash="$(mdb_ctr run --rm "$caddy_image" caddy hash-password --plaintext "$ui_password" 2>/dev/null || true)"
    if [[ -z "$ui_hash" ]]; then
        printf '  could not compute the UI password hash (is docker running?)\n' >&2
        printf '  set MDB_UI_BASIC_AUTH_HASH manually: caddy hash-password\n' >&2
        exit 1
    fi

    # BSD and GNU sed disagree about -i, so edit through a temporary file.
    tmp="$(mktemp)"
    sed -e 's|^MDB_TLS_ENFORCE=.*|MDB_TLS_ENFORCE=true|' \
        -e 's|^MDB_PROFILES=.*|MDB_PROFILES="pg,prod,backup"|' \
        -e 's|^MDB_PG_SLOW_MS=.*|MDB_PG_SLOW_MS=0|' \
        -e 's|^MDB_MYSQL_SLOW_SECONDS=.*|MDB_MYSQL_SLOW_SECONDS=0|' \
        -e 's|^MDB_MARIADB_SLOW_SECONDS=.*|MDB_MARIADB_SLOW_SECONDS=0|' \
        -e 's|^MDB_BACKUP_ENCRYPT=.*|MDB_BACKUP_ENCRYPT=true|' \
        -e 's|^MDB_PG_PITR=.*|MDB_PG_PITR=true|' \
        -e 's|^MDB_PGBACKREST_REPO_TYPE=.*|MDB_PGBACKREST_REPO_TYPE=s3|' \
        -e 's|^#MDB_PG_HOST_PORT=.*|#MDB_PG_HOST_PORT=|' \
        -e "s|^#*MDB_UI_BASIC_AUTH_USER=.*|MDB_UI_BASIC_AUTH_USER=admin|" \
        -e "s|^#*MDB_UI_BASIC_AUTH_HASH=.*|MDB_UI_BASIC_AUTH_HASH=${ui_hash//|/\\|}|" \
        "$TARGET" > "$tmp"
    mv "$tmp" "$TARGET"

    printf '  TLS enforced, no engine ports published, backups encrypted\n'
    printf '  UI login: admin / (see secrets/ui_password.txt)\n'
    printf '\n'
    # shellcheck disable=SC2016  # backticks are prose here, not substitution
    printf '  STILL REQUIRED before `make up`:\n'
    printf '    - MDB_CADDY_ACME_EMAIL in %s\n' "${TARGET#"$ROOT"/}"
    # PITR to an off-site repository is required in prod (SPEC section 18, 7b
    # and 7c), and these are the only parts init cannot generate.
    printf '    - MDB_PGBACKREST_S3_BUCKET and _ENDPOINT in %s\n' "${TARGET#"$ROOT"/}"
    printf '    - secrets/pgbackrest_s3_key.txt and secrets/pgbackrest_s3_secret.txt\n'
    printf '  Without it the prod Caddy config refuses to render, rather than\n'
    printf '  publishing a UI with no certificate.\n'
fi

# -----------------------------------------------------------------------------
# 5. Validate
# -----------------------------------------------------------------------------
MDB_ENV_FILE="$TARGET" MDB_CHECK_RENDERING="$PROD" "$ROOT/scripts/check-env"

# -----------------------------------------------------------------------------
# 6. Generate the compose overlay
# -----------------------------------------------------------------------------
# COMPOSE_FILE names compose.engines.yml, and nothing but `make up`, `make
# render` and `make test-profile` used to write it -- so between `make init` and
# the first `make up` the project was in a state where EVERY compose command
# failed, including the plain `docker compose ps` and `docker compose logs` the
# docs suggest. The error names the missing file rather than the missing step,
# so it reads as a broken repository.
#
# `make up` still regenerates, so nothing here goes stale: editing
# COMPOSE_PROFILES or MDB_PUBLISH in .env and running `make up` rewrites it.
# This only ensures the file exists from the moment init finishes.
"$ROOT/scripts/gen-compose" >/dev/null

printf '\nNext: make up\n'
