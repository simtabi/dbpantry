#!/usr/bin/env bash
#
# Provision a project: database, least-privilege owner role, readonly role, the
# configured extensions, and a paste-ready connection block (SPEC sections 8
# and 14).
#
# This is the command SPEC section 1's promise rests on -- "a new project
# connects in under a minute" -- so it does the whole job and prints exactly
# what the caller needs next, rather than provisioning and leaving them to work
# out the connection details.
#
# It used to branch on the engine and supported three of the six. Everything
# engine-specific now lives in the family hooks, so a new engine gets
# new-project by existing rather than by someone remembering to add a case.
#
# Usage: scripts/new-project --name myapp [--engine pg|mysql|mariadb|mongodb|cassandra|ferretdb] [--format text|json] [--show|--rotate]
#
# --format json prints one JSON object on stdout instead of the text block, and
# sends every log line (the hooks' too) to stderr. `dbpantry project new` reads
# it to draw its tables; the text output is unchanged.
#
# --show provisions nothing and generates nothing: it prints the block for a
# project that already exists, from its password files (the dashboard's project
# page). It fails when the project has no password file on that engine.
#
# --rotate gives an existing project's roles new passwords: it generates them
# beside the old files, provisions with them (which sets the roles' passwords
# and touches nothing else), and only then replaces the files, so a failure
# leaves the old passwords working. Applications using the old ones stop
# connecting, so it asks for the project name first; CONFIRM=yes answers.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=backend-lib.sh
. "$ROOT/scripts/backend-lib.sh"
cd "$ROOT" || exit 1

# shellcheck source=project-lib.sh
. "$ROOT/scripts/project-lib.sh"

ENV_FILE="${MDB_ENV_FILE:-$MDB_HOME/.env}"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$ROOT/.env.example"

get() { mdb_env_get "$1" "$ENV_FILE"; }
FORMAT=text
SHOW=0
ROTATE=0
log() { if [[ "$FORMAT" == json ]]; then printf '[new-project] %s\n' "$*" >&2; else printf '[new-project] %s\n' "$*"; fi; }
die() { printf '[new-project] ERROR: %s\n' "$*" >&2; exit 1; }

NAME=""
ENGINE="pg"
while (( $# )); do
    case "$1" in
        --name)   NAME="${2:-}"; shift 2 ;;
        --engine) ENGINE="${2:-}"; shift 2 ;;
        --format) FORMAT="${2:-}"; shift 2 ;;
        --show)   SHOW=1; shift ;;
        --rotate) ROTATE=1; shift ;;
        *) die "unknown argument: $1" ;;
    esac
done
(( SHOW && ROTATE )) && die "--show and --rotate do not go together"

[[ "$FORMAT" == text || "$FORMAT" == json ]] || die "--format is text or json, not '$FORMAT'"
project_check_name "$NAME"
project_load_engine "$ENGINE"
project_require_hook hook_provision_project

DB="$NAME"
project_secret_files "$NAME"

# -----------------------------------------------------------------------------
# Passwords
# -----------------------------------------------------------------------------
# The owner and the read-only role get DIFFERENT passwords. They are separate
# principals, and a shared credential means leaking the read-only one leaks the
# writable one too.
SECRET_ACTIONS=()
write_password() {
    mkdir -p "$(dirname "$1")"
    ( umask 077 && openssl rand -base64 96 | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-40 > "$1" )
}
gen_password() {
    local file="$1"
    if [[ -s "$file" ]]; then
        log "reusing the existing password in $file"
        SECRET_ACTIONS+=("reused")
    else
        write_password "$file"
        log "generated $file"
        SECRET_ACTIONS+=("generated")
    fi
}

# The files the passwords are read from: the new ones beside the old under
# --rotate, until provisioning has set them.
PW_FILE="$SECRET_FILE"
RO_PW_FILE="$RO_SECRET_FILE"
missing="no project '$NAME' on $ENGINE (no $(project_rel "$SECRET_FILE")); provision it with dbpantry project new --name $NAME --engine $ENGINE"
if (( SHOW )); then
    [[ -s "$SECRET_FILE" ]] || die "$missing"
    SECRET_ACTIONS=("existing" "$([[ -s "$RO_SECRET_FILE" ]] && echo existing || echo missing)")
elif (( ROTATE )); then
    [[ -s "$SECRET_FILE" ]] || die "$missing"
    if [[ "${CONFIRM:-}" != "yes" ]]; then
        printf '\nAbout to give the roles of project "%s" on %s new passwords.\n' "$NAME" "$ENGINE" >&2
        printf 'Applications using the old ones stop connecting until they are given the new.\n\n' >&2
        printf 'Type the project name to continue: ' >&2
        read -r answer || answer=""
        [[ "$answer" == "$NAME" ]] || die "confirmation did not match; nothing was changed"
    fi
    PW_FILE="$SECRET_FILE.new"
    RO_PW_FILE="$RO_SECRET_FILE.new"
    trap 'rm -f "$PW_FILE" "$RO_PW_FILE"' EXIT
    write_password "$PW_FILE"
    write_password "$RO_PW_FILE"
    SECRET_ACTIONS=("rotated" "rotated")
else
    gen_password "$SECRET_FILE"
    gen_password "$RO_SECRET_FILE"
fi
PASSWORD="$(cat "$PW_FILE")"
RO_PASSWORD="$(cat "$RO_PW_FILE" 2>/dev/null || true)"

# -----------------------------------------------------------------------------
# Provision
# -----------------------------------------------------------------------------
upper="$(printf '%s' "$ENGINE" | tr '[:lower:]-' '[:upper:]_')"
EXTENSIONS="$(get "MDB_${upper}_INIT_EXTENSIONS")"

# In JSON mode stdout carries only the object, so the hook's notices go to stderr.
if (( SHOW )); then
    :
elif [[ "$FORMAT" == json ]]; then
    hook_provision_project "$DB" "$USER_NAME" "$PASSWORD" "$EXTENSIONS" "$RO_PASSWORD" >&2
else
    hook_provision_project "$DB" "$USER_NAME" "$PASSWORD" "$EXTENSIONS" "$RO_PASSWORD"
fi \
    || die "provisioning failed on $ENGINE; is it running? (make up PROFILES=$ENGINE)"

if (( ROTATE )); then
    mv -f "$PW_FILE" "$SECRET_FILE"
    mv -f "$RO_PW_FILE" "$RO_SECRET_FILE"
    log "rotated the passwords of '$USER_NAME' and '${USER_NAME}_readonly'; give your applications the new ones"
fi

if (( ! SHOW )); then
    log "provisioned '$DB' on $ENGINE, owned by '$USER_NAME'"
    [[ -n "$EXTENSIONS" ]] && log "extensions requested: $EXTENSIONS"
fi

# What the database has, which is not always what was asked for: an extension
# the image does not ship is warned about and skipped. Unknown (null in JSON)
# when the family cannot say.
ACTIVE_EXTENSIONS=""
HAVE_ACTIVE=0
if command -v hook_list_extensions >/dev/null 2>&1 \
        && line="$(hook_list_extensions "$DB" 2>/dev/null)"; then
    HAVE_ACTIVE=1
    ACTIVE_EXTENSIONS="${line#*$'\t'}"
    if (( ! SHOW )); then
        log "extensions active: ${ACTIVE_EXTENSIONS:-none}"
        for e in ${EXTENSIONS//,/ }; do
            [[ ",$ACTIVE_EXTENSIONS," == *",$e,"* ]] || log "WARNING: extension $e was requested but is not active"
        done
    fi
fi

# -----------------------------------------------------------------------------
# The paste-ready block (SPEC section 14)
# -----------------------------------------------------------------------------
# Values go through mdb_env_quote: anything with whitespace or a special
# character is double-quoted, so the block pastes into any .env unchanged.
#
# The block is built once and either printed between the rules (text) or
# carried in the JSON object (json), so both say exactly the same.
block="DB_CONNECTION=$(mdb_env_quote "${MDB_ENGINE_DRIVER}")
DB_HOST=$(mdb_env_quote "${ENGINE}")
DB_PORT=$(mdb_env_quote "${MDB_ENGINE_PORT}")
DB_DATABASE=$(mdb_env_quote "${DB}")
DB_USERNAME=$(mdb_env_quote "${USER_NAME}")
DB_PASSWORD=$(mdb_env_quote "${PASSWORD}")
"

if engine_tls_always; then
    block+="
# TLS is always on for this engine. verify-full is the only mode that checks
# the hostname, so it is the only one worth using; point it at the toolkit CA:
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/path/to/dbpantry/certs/ca.crt
"
else
    block+="
# In the prod profile the server refuses plaintext TCP, so point your client
# at the toolkit CA:
DB_SSL_CA=/path/to/dbpantry/certs/ca.crt
"
fi

POOLER_HOST=""
POOLER_PORT=""
if engine_has_external_pooler; then
    POOLER_HOST="${ENGINE}-pooler"
    POOLER_PORT="${MDB_ENGINE_POOLER_PORT:-6432}"
    block+="
# A pooler is available and is REQUIRED in production for this engine. With
# \`make up PROFILES=${ENGINE},pooler\`, connect through it instead:
#   DB_HOST=${POOLER_HOST}
#   DB_PORT=${POOLER_PORT}
"
fi

# Mutual TLS (design.md D-74): the role gets a client certificate whose CN is
# its own name, which is what PostgreSQL checks on a direct connection and what
# the pooler requires before it asks for the password.
if [[ "$(get MDB_MTLS)" == "true" ]] && engine_tls_always; then
    # --show reports a certificate that exists; it never issues one.
    have_cert=0
    if (( SHOW )); then
        [[ -f "$MDB_HOME/certs/clients/${USER_NAME}/client.crt" ]] && have_cert=1
    elif "$ROOT/scripts/certs" --client "$USER_NAME" >/dev/null; then
        have_cert=1
    else
        log "WARNING: could not issue a client certificate for '$USER_NAME'; run: scripts/certs --client $USER_NAME"
    fi
    if (( have_cert )); then
        block+="
# MDB_MTLS is on: present this role's client certificate as well. Copy the
# three files to the application server; the key never leaves it again.
DB_SSLCERT=/path/to/dbpantry/certs/clients/${USER_NAME}/client.crt
DB_SSLKEY=/path/to/dbpantry/certs/clients/${USER_NAME}/client.key
"
    fi
fi

NETWORK="$(mdb_project_name)_net"

if [[ "$FORMAT" == json ]]; then
    exts="" sep=""
    for e in ${EXTENSIONS//,/ }; do exts+="${sep}$(json_str "$e")"; sep=","; done
    active="null"
    if (( HAVE_ACTIVE )); then
        active="" sep=""
        for e in ${ACTIVE_EXTENSIONS//,/ }; do active+="${sep}$(json_str "$e")"; sep=","; done
        active="[${active}]"
    fi
    pooler="null"
    [[ -n "$POOLER_HOST" ]] && pooler="{\"host\":$(json_str "$POOLER_HOST"),\"port\":$(json_str "$POOLER_PORT")}"
    printf '{"engine":%s,"title":%s,"database":%s,"owner":%s,"readonly":%s,"extensions":[%s],"extensions_active":%s,"secrets":[{"role":%s,"file":%s,"action":%s},{"role":%s,"file":%s,"action":%s}],"tls_always":%s,"pooler":%s,"network":%s,"block":%s}\n' \
        "$(json_str "$ENGINE")" "$(json_str "${MDB_ENGINE_TITLE:-$ENGINE}")" "$(json_str "$DB")" \
        "$(json_str "$USER_NAME")" "$(json_str "${USER_NAME}_readonly")" "$exts" "$active" \
        "$(json_str "$USER_NAME")" "$(json_str "${SECRET_FILE#"$MDB_HOME"/}")" "$(json_str "${SECRET_ACTIONS[0]:-}")" \
        "$(json_str "${USER_NAME}_readonly")" "$(json_str "${RO_SECRET_FILE#"$MDB_HOME"/}")" "$(json_str "${SECRET_ACTIONS[1]:-}")" \
        "$(engine_tls_always && echo true || echo false)" "$pooler" "$(json_str "$NETWORK")" "$(json_str "$block")"
    exit 0
fi

cat <<BLOCK

────────────────────────────────────────────────────────────────────────
Paste into your .env:

${block}
Your app container must join the toolkit network:

  networks:
    default:
      external: true
      name: ${NETWORK}

Passwords also live in:
  ${SECRET_FILE#"$MDB_HOME"/}
  ${RO_SECRET_FILE#"$MDB_HOME"/}   (read-only role '${USER_NAME}_readonly')
────────────────────────────────────────────────────────────────────────
BLOCK
