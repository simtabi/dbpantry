# Verify checks source lib.sh through a dynamic path
# ("$(dirname "${BASH_SOURCE[0]}")/lib.sh"), which shellcheck cannot resolve
# statically. SCRIPTDIR tells it to look next to the script being checked.
source-path=SCRIPTDIR
external-sources=true

# SC2119: the backend verbs (mdb_be_running, mdb_be_info, ...) forward "$@" to
# the backend, and most callers rightly pass nothing (design.md D-62).
disable=SC2119
