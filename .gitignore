# CLAUDE.md is a tracked build contract in this repo (kit.md section 2).
# The user's global excludes file ignores it; this negation wins because a
# repo .gitignore takes precedence over core.excludesFile.
!CLAUDE.md

# Generated secrets and certificates: never committed (spec.md section 15).
# Ignore the contents but keep the directories, so a fresh clone still has
# somewhere for `make init` and `make certs` to write.
secrets/*
!secrets/.gitkeep
certs/*
!certs/.gitkeep

# Local environment files.
.env
.env.prod
.env.local
!.env.example

# Build output.
build/dist/
build/macos/
build/linux/
build/windows/
build/freebsd/

# OS noise.
.DS_Store
Thumbs.db

# Rendered from templates by scripts/env-render; the templates are the source.
config/caddy/Caddyfile
config/caddy/servers.json

# Dumps are data, not source.
backups/*
!backups/.gitkeep

# Generated from engines/*/engine.conf by scripts/gen-compose.
compose.engines.yml

# Generated by scripts/gen-compose
compose.proxy.yml
config/caddy/layer4.caddy
