# CLAUDE.md is a tracked build contract in this repo (kit.md section 2).
# The user's global excludes file ignores it; this negation wins because a
# repo .gitignore takes precedence over core.excludesFile.
!CLAUDE.md

# Generated secrets and certificates: never committed (spec.md section 15).
# Ignore the contents but keep the directories, so a fresh clone still has
# somewhere for `make init` and `make certs` to write.
secrets/*
!secrets/.gitkeep
certs/*
!certs/.gitkeep

# What the dashboard keeps in the instance home, which is the checkout by
# default (design.md D-84): token hashes, webhook signing secrets, settings,
# the audit log, and the environment registry when the operator home is here
# too. Check 89 reads these names from the Go source.
/api-tokens.json
/webhooks.json
/dashboard.json
/envs.json
/audit/

# Local environment files.
.env
.env.prod
.env.local
!.env.example

# Build output.
build/dist/
build/macos/
build/linux/
build/windows/
build/freebsd/
build/checksums.txt

# OS noise.
.DS_Store
Thumbs.db

# Rendered from templates by scripts/env-render; the templates are the source.
config/caddy/Caddyfile
config/caddy/servers.json

# Dumps are data, not source.
backups/*
!backups/.gitkeep

# Generated from engines/*/engine.conf by scripts/gen-compose.
compose.engines.yml
compose.prod.engines.yml

# Generated by scripts/gen-compose
compose.proxy.yml
config/caddy/layer4.caddy

# The kit the binary embeds, copied by `make kit` (design.md D-85); the
# originals are at the repository root.
src/internal/kit/files/*
!src/internal/kit/files/README.md

# Local agent smoke / e2e artefacts.
.tmp-e2e/
.tmp-smoke/

# GoReleaser's working directory (src/.goreleaser.yaml dist:).
.goreleaser-dist/
